{
  "name": "personal-website",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "version": "4.1.1",
  "scripts": {
    "gen": "node scripts/gen-all.mjs",
    "dev": "npm run gen && astro dev",
    "dev:check": "npm run gen && astro check --watch & astro dev",
    "build": "npm run gen && astro-pure check && astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "test": "node --test scripts/*.test.mjs",
    "astro": "astro",
    "pure": "astro-pure",
    "new": "astro-pure new",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "rm -rf .astro .vercel dist",
    "cache:avatars": "tsx preset/scripts/cacheAvatars.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/vercel": "^8.0.4",
    "@retorquere/bibtex-parser": "^9.0.26",
    "@types/markdown-it": "^14.1.2",
    "@waline/client": "^3.8.0",
    "astro": "^5.16.3",
    "astro-pure": "1.3.9",
    "ejs": "^3.1.10",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1"
  }
}
