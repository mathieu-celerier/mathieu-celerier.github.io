---
import { Card, Button } from 'astro-pure/user'

interface Project {
  slug: string
  name: string
  description: string
  featured: boolean
  links: { label: string; url: string }[]
}

interface Props {
  project: Project
}

const { project } = Astro.props
---

<Card
  id={project.slug}
  heading={project.name}
  subheading={project.description}
  class:list={['repo-card', project.featured && 'repo-card-featured']}
>
  {
    project.links.length > 0 && (
      <div class='repo-links' aria-label={`${project.name} links`}>
        {project.links.map((link) => (
          <Button href={link.url} target='_blank' variant='ahead' title={link.label} />
        ))}
      </div>
    )
  }
</Card>

<style>
  .repo-card {
    min-width: 0;
  }

  .repo-card :global(h2) {
    font-size: 1.05rem;
    overflow-wrap: break-word;
  }

  .repo-card :global(p) {
    font-size: 0.9rem;
    line-height: 1.55;
    overflow-wrap: break-word;
  }

  .repo-card-featured {
    border-color: hsl(var(--primary) / 0.35);
  }

  .repo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
</style>
