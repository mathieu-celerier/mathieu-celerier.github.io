---
import PageLayout from '@/layouts/BaseLayout.astro'
import PageIntro from '@/components/PageIntro.astro'
import RepoCard from '@/components/projects/RepoCard.astro'
import projectsData from '@/data/projects.generated.json'

interface Project {
  slug: string
  name: string
  description: string
  featured: boolean
  links: { label: string; url: string }[]
}

const projects = projectsData as Project[]
---

<!--
  This is intentionally a component rather than a file in src/pages, so it
  does not create a public /projects route. Move it back into src/pages when
  the project catalogue is ready to be published.
-->
<PageLayout meta={{ title: 'Projects', ogImage: '/og/projects.png' }} highlightColor='hsl(var(--primary))'>
  <PageIntro
    kicker='Software'
    title='Projects'
    copy='Research projects and their public software, data, and other artifacts.'
  />

  {
    projects.length > 0 ? (
      <div class='projects-grid'>
        {projects.map((project) => (
          <div data-reveal>
            <RepoCard project={project} />
          </div>
        ))}
      </div>
    ) : (
      <p class='projects-empty'>Nothing curated here yet.</p>
    )
  }
</PageLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.1rem;
  }

  .projects-empty {
    color: hsl(var(--muted-foreground) / 1);
  }
</style>
