---
import { Icon } from 'astro-pure/user'
import config from '@/site-config'

const current = Astro.url.pathname
---

<header class='site-header'>
  <a class='brand' href='/' aria-label='Mathieu Celerier — home'>Mathieu Celerier</a>
  <nav aria-label='Main navigation'>
    {
      config.header.menu?.map((item) => (
        <a href={item.link} aria-current={current.startsWith(item.link) ? 'page' : undefined}>
          {item.title}
        </a>
      ))
    }
  </nav>
  <div class='controls'>
    <a href='/search' aria-label='Search'><Icon name='search' /></a>
    <button type='button' data-theme-toggle aria-label='Switch color theme'
      ><span class='sun'><Icon name='sun' /></span><span class='moon'><Icon name='moon' /></span
      ></button
    >
  </div>
</header>
<script>
  import { setTheme } from '../../packages/pure/utils/theme'

  function init() {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
    if (!button || button.dataset.bound) return
    button.dataset.bound = 'true'
    const label = () =>
      button.setAttribute(
        'aria-label',
        `Switch to ${document.documentElement.classList.contains('dark') ? 'light' : 'dark'} mode`
      )
    label()
    button.addEventListener('click', () => {
      setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark', true)
      label()
    })
  }
  init()
  document.addEventListener('astro:page-load', init)
  document.addEventListener('site-theme-change', () => {
    document
      .querySelector('[data-theme-toggle]')
      ?.setAttribute(
        'aria-label',
        `Switch to ${document.documentElement.classList.contains('dark') ? 'light' : 'dark'} mode`
      )
  })
</script>
<style>
  .sun {
    display: none;
  }
  :global(html.dark) .sun {
    display: block;
  }
  :global(html.dark) .moon {
    display: none;
  }
  .site-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .brand {
    margin-right: auto;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 1.4rem;
  }
  nav a {
    font-size: 0.82rem;
    color: hsl(var(--muted-foreground));
    padding: 0.5rem 0;
  }
  nav a[aria-current] {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 0.5rem;
  }
  .controls {
    display: flex;
    gap: 0.3rem;
  }
  .controls a,
  .controls button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .controls :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .controls a:hover,
  .controls button:hover {
    background: hsl(var(--muted));
  }
  @media (max-width: 760px) {
    .site-header {
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 1rem 0 0.5rem;
    }
    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
      padding-top: 0.4rem;
    }
  }
</style>
