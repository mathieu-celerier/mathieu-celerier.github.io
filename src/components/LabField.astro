---
import { loadCV } from '@/lib/cv-data-loader'

const { basics } = loadCV()
---

<lab-field class='field'>
  <div class='field-meta'>
    <span><i></i> ROBOTICS RESEARCH / MATHIEU CELERIER</span>
    <span>CNRS–AIST JRL · TSUKUBA, JP</span>
  </div>

  <div class='field-copy'>
    <p class='identity'>Mathieu Celerier · {basics.position}</p>
    <h1>Sustained interaction.<br /><em>Motion to prediction.</em></h1>
    <p class='dek'>
      My research spans online trajectory generation and torque control for sustained physical
      human–robot interaction, and now predictive models for collaboration.
    </p>
    <div class='field-actions'>
      <a href='#now'>Current research <span aria-hidden='true'>↓</span></a>
      <a href='/publications'>View publications ↗</a>
    </div>
  </div>

  <div class='field-map' aria-hidden='true'>
    <svg viewBox='0 0 780 700'>
      <defs>
        <radialGradient id='field-glow'>
          <stop stop-color='currentColor' stop-opacity='.28'></stop>
          <stop offset='1' stop-color='currentColor' stop-opacity='0'></stop>
        </radialGradient>
        <filter id='soft-glow' x='-100%' y='-100%' width='300%' height='300%'>
          <feGaussianBlur stdDeviation='7'></feGaussianBlur>
        </filter>
      </defs>
      <circle class='ambient' cx='417' cy='345' r='300' fill='url(#field-glow)'></circle>
      <g class='coordinates'>
        <circle cx='417' cy='345' r='235'></circle>
        <circle cx='417' cy='345' r='157'></circle>
        <circle cx='417' cy='345' r='78'></circle>
        <path d='M87 345H747M417 15V675'></path>
        <path d='M183 111L651 579M651 111L183 579' stroke-dasharray='3 12'></path>
      </g>
      <g class='connections'>
        <path d='M197 453Q315 314 417 345T636 218'></path>
        <path d='M197 453Q393 550 590 492'></path>
        <path d='M636 218Q617 363 590 492'></path>
      </g>
      <g class='trace'>
        <path d='M108 382C195 379 206 293 276 307S354 422 417 345S494 252 555 282S630 365 705 314'
        ></path>
      </g>
      <g class='field-node node-motion' transform='translate(197 453)'>
        <circle class='halo' r='54'></circle><circle class='core' r='11'></circle>
        <text x='-80' y='84'>ONLINE MINIMUM JERK</text>
      </g>
      <g class='field-node node-constraints' transform='translate(636 218)'>
        <circle class='halo' r='54'></circle><rect
          class='core'
          x='-10'
          y='-10'
          width='20'
          height='20'></rect>
        <text x='-52' y='82'>COMPLIANCE + SAFETY</text>
      </g>
      <g class='field-node node-interaction' transform='translate(590 492)'>
        <circle class='halo' r='54'></circle><path
          class='core'
          d='M-13 0A13 13 0 0026 0A13 13 0 00-13 0Z'></path>
        <text x='-48' y='84'>PREDICTIVE pHRC</text>
      </g>
      <g class='origin' transform='translate(417 345)'>
        <circle r='26'></circle><circle r='5'></circle><path d='M-40 0H40M0-40V40'></path>
      </g>
      <g class='map-labels'>
        <text x='95' y='74'>RESEARCH SCOPE</text>
        <text x='95' y='94'>FORCE · MOTION · COLLABORATION</text>
        <text x='648' y='625'>TASK SPACE / x</text>
        <text x='428' y='34'>TASK SPACE / y</text>
      </g>
    </svg>
  </div>
</lab-field>

<script>
  class LabField extends HTMLElement {
    cleanup?: () => void

    connectedCallback() {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)')
      const controller = new AbortController()
      const options = { signal: controller.signal }

      this.addEventListener(
        'pointermove',
        (event) => {
          if (reduced.matches) return
          const bounds = this.getBoundingClientRect()
          this.style.setProperty(
            '--field-x',
            String((event.clientX - bounds.left) / bounds.width - 0.5)
          )
          this.style.setProperty(
            '--field-y',
            String((event.clientY - bounds.top) / bounds.height - 0.5)
          )
        },
        options
      )

      this.cleanup = () => controller.abort()
    }

    disconnectedCallback() {
      this.cleanup?.()
    }
  }

  if (!customElements.get('lab-field')) customElements.define('lab-field', LabField)
</script>

<style>
  .field {
    --field-x: 0;
    --field-y: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(31rem, 1.1fr);
    grid-template-rows: auto 1fr;
    position: relative;
    isolation: isolate;
    width: calc(100vw - 2rem);
    max-width: 1500px;
    min-height: min(820px, calc(100svh - 2rem));
    margin: 1.5rem 0 0 50%;
    transform: translateX(-50%);
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 14px;
    background:
      radial-gradient(circle at 77% 40%, hsl(var(--primary) / 0.13), transparent 34%),
      linear-gradient(135deg, hsl(var(--card)), hsl(var(--muted) / 0.56));
  }
  .field::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(hsl(var(--foreground) / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--foreground) / 0.045) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(90deg, transparent, black 45%);
  }
  .field-meta {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid hsl(var(--border));
    font: 0.66rem/1.4 monospace;
    letter-spacing: 0.08em;
    color: hsl(var(--muted-foreground));
  }
  .field-meta span:first-child {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .field-meta i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: hsl(var(--signal));
    box-shadow: 0 0 12px hsl(var(--signal));
  }
  .field-copy {
    align-self: center;
    z-index: 2;
    padding: 4rem 0 5rem 3.5rem;
  }
  .identity {
    margin: 0 0 1.7rem;
    font: 0.76rem/1.5 monospace;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground));
  }
  h1 {
    margin: 0;
    max-width: 48rem;
    font-size: clamp(4.5rem, 7.7vw, 8.8rem);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.07em;
  }
  h1 em {
    display: inline-block;
    margin-left: 0.65em;
    color: hsl(var(--primary));
    font-family: Georgia, serif;
    font-weight: 400;
    white-space: nowrap;
  }
  .dek {
    max-width: 26rem;
    margin: 2.2rem 0;
    color: hsl(var(--muted-foreground));
    font-size: 1.05rem;
  }
  .field-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    align-items: center;
    font-size: 0.82rem;
  }
  .field-actions a:first-child {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    min-width: 10rem;
    padding: 0.85rem 1rem;
    border-radius: 4px;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .field-map {
    position: absolute;
    top: 4rem;
    right: -1%;
    width: min(62vw, 790px);
    color: hsl(var(--primary));
    transform: translate(calc(var(--field-x) * -10px), calc(var(--field-y) * -10px));
    transition: transform 180ms ease-out;
  }
  svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .ambient {
    opacity: 0.7;
  }
  .coordinates,
  .connections,
  .trace,
  .origin {
    fill: none;
    stroke: currentColor;
  }
  .coordinates {
    opacity: 0.18;
  }
  .connections {
    opacity: 0.4;
    stroke-dasharray: 3 7;
  }
  .trace {
    color: hsl(var(--signal));
    opacity: 0.75;
    stroke-width: 2;
    stroke-dasharray: 4 9;
    animation: signal-flow 18s linear infinite;
  }
  .field-node {
    color: hsl(var(--muted-foreground));
    transition:
      color 300ms ease,
      opacity 300ms ease;
  }
  .field-node .halo {
    fill: currentColor;
    opacity: 0.07;
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }
  .field-node .core {
    fill: hsl(var(--background));
    stroke: currentColor;
    stroke-width: 3;
  }
  .field-node text,
  .map-labels text {
    fill: currentColor;
    font: 10px monospace;
    letter-spacing: 0.1em;
  }
  .map-labels {
    color: hsl(var(--muted-foreground));
    opacity: 0.65;
  }
  .origin {
    opacity: 0.65;
  }
  .origin circle:first-child {
    fill: hsl(var(--primary) / 0.09);
  }
  .origin circle:nth-child(2) {
    fill: currentColor;
  }
  .node-motion {
    color: hsl(var(--primary));
  }
  .node-constraints {
    color: hsl(var(--signal));
  }
  .node-interaction {
    color: hsl(var(--muted-foreground));
  }
  @keyframes signal-flow {
    to {
      stroke-dashoffset: -260;
    }
  }
  @media (max-width: 900px) {
    .field {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      min-height: 840px;
    }
    .field-copy {
      align-self: start;
      padding: 4rem 2rem;
    }
    h1 {
      font-size: clamp(4rem, 12vw, 7rem);
    }
    .field-map {
      top: 14rem;
      right: -18%;
      width: 88vw;
      opacity: 0.78;
    }
  }
  @media (max-width: 560px) {
    .field {
      width: 100vw;
      min-height: 850px;
      margin-top: 0.75rem;
      border-inline: 0;
      border-radius: 0;
    }
    .field-meta span:last-child {
      display: none;
    }
    .field-copy {
      padding: 3rem 1.25rem;
    }
    h1 {
      font-size: clamp(3.25rem, 15vw, 4rem);
      line-height: 0.88;
    }
    h1 em {
      margin-left: 0;
      white-space: normal;
    }
    .field-map {
      top: 19rem;
      right: -45%;
      width: 145vw;
    }
    .map-labels {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .field-map {
      transition: none;
      transform: none;
    }
    .trace {
      animation: none !important;
    }
  }
</style>
