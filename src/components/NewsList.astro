---
import { getCollection } from 'astro:content'
import MarkdownIt from 'markdown-it'

import { Button } from 'astro-pure/user'

type Props = {
  collection?: 'news'
  linkClass?: string
  moreMarker?: string
  dateFormat?: 'YYYY/MM/DD' | 'ja-JP' | 'en-GB'
  order?: 'asc' | 'desc'
  maxItems?: number
  compact?: boolean
  showHeading?: boolean
  /** Render entries without their own card chrome (for embedding inside an
      already-bordered container, e.g. a homepage tile). */
  flat?: boolean
}

const {
  collection = 'news',
  linkClass = 'styled-link',
  moreMarker = '{/* more */}',
  dateFormat = 'YYYY/MM/DD',
  order = 'desc',
  maxItems,
  compact = false,
  showHeading = true,
  flat = false
} = Astro.props as Props

const md = new MarkdownIt({
  html: false,
  linkify: true,
  breaks: true
})

const defaultLinkOpen =
  md.renderer.rules.link_open ??
  ((tokens, idx, options, _env, self) => self.renderToken(tokens, idx, options))

md.renderer.rules.link_open = (tokens, idx, options, env, self) => {
  const token = tokens[idx]
  const classIndex = token.attrIndex('class')

  if (classIndex < 0) {
    token.attrPush(['class', linkClass])
  } else {
    token.attrs ??= []
    token.attrs[classIndex][1] += ` ${linkClass}`
  }

  return defaultLinkOpen(tokens, idx, options, env, self)
}

const formatDate = (date: Date) => {
  if (dateFormat === 'YYYY/MM/DD') {
    const y = String(date.getFullYear()).padStart(4, '0')
    const m = String(date.getMonth() + 1).padStart(2, '0')
    const d = String(date.getDate()).padStart(2, '0')
    return `${y}/${m}/${d}`
  }

  return date.toLocaleDateString(dateFormat, {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

const basePath = '/news'
const items = (await getCollection(collection)).sort((a, b) => {
  const diff = a.data.date.getTime() - b.data.date.getTime()
  return order === 'asc' ? diff : -diff
})

const entries = [
  ...items.map((item) => {
    const body = item.body ?? ''
    const hasMore = body.includes(moreMarker)
    const hasPageFlag = item.data.hasPage === true
    const href = item.data.externalUrl || `${basePath}/${item.id}`
    const summaryMd = (body.split(moreMarker)[0] ?? '').trim()

    return {
      id: item.id,
      title: item.data.title,
      date: item.data.date,
      formattedDate: formatDate(item.data.date),
      isoDate: item.data.date.toISOString(),
      tags: item.data.tags ?? [],
      href,
      isExternal: Boolean(item.data.externalUrl),
      hasDedicatedPage: hasPageFlag || hasMore || Boolean(item.data.externalUrl),
      summaryHtml: md.render(summaryMd),
      image: item.data.image
    }
  })
]
  .sort((a, b) => {
    const diff = a.date.getTime() - b.date.getTime()
    return order === 'asc' ? diff : -diff
  })
  .slice(0, maxItems ?? Number.POSITIVE_INFINITY)

const timelineEntries = entries.map((entry, index, array) => {
  const year = entry.date.getFullYear()
  const previousYear = index > 0 ? array[index - 1].date.getFullYear() : null

  return {
    ...entry,
    year,
    showYearLabel: year !== previousYear,
    featured: !compact && index === 0
  }
})
---

{
  timelineEntries.length > 0 && (
    <section class:list={['news-list', compact && 'news-list-compact', flat && 'news-list-flat']}>
      <section class='news-timeline-section'>
        {showHeading && (
          <div class='news-timeline-heading'>
            <h2>Timeline</h2>
            <p>Recent milestones, talks, papers, and project updates in chronological order.</p>
          </div>
        )}

        <ol class='news-timeline'>
          {timelineEntries.map((entry) => (
            <Fragment>
              {entry.showYearLabel ? (
                <li class='news-year-divider'>
                  <span>{entry.year}</span>
                </li>
              ) : null}
              <li class='news-timeline-item'>
                <article
                  class:list={[
                    'news-timeline-card',
                    entry.featured && 'news-timeline-card-featured'
                  ]}
                  data-reveal
                >
                  <div class='news-timeline-top'>
                    <time class='news-timeline-date' datetime={entry.isoDate}>
                      {entry.formattedDate}
                    </time>
                    {entry.featured ? (
                      <Fragment>
                        <p class='news-kicker'>Latest update</p>
                      </Fragment>
                    ) : null}
                    {!!entry.tags.length && (
                      <div class='news-tag-row' aria-label='Tags'>
                        {entry.tags.map((tag) => (
                          <span class='news-tag'>{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>

                  <div class='news-card-body'>
                    <div class='news-card-text'>
                      <h3
                        class:list={[
                          'news-card-title',
                          entry.featured && 'news-card-title-featured'
                        ]}
                      >
                        {entry.title}
                      </h3>
                      <div
                        class:list={['news-summary', !entry.featured && 'news-summary-compact']}
                        set:html={entry.summaryHtml}
                      />
                    </div>
                    {entry.image ? (
                      <img src={entry.image} alt='' class='news-card-thumb' loading='lazy' />
                    ) : null}
                  </div>

                  {entry.hasDedicatedPage ? (
                    <div class='news-card-actions'>
                      <Button
                        href={entry.href}
                        target={entry.isExternal ? '_blank' : undefined}
                        variant='ahead'
                        class={entry.featured ? 'news-cta' : undefined}
                        title={entry.isExternal ? 'Open update' : 'Read update'}
                      />
                    </div>
                  ) : null}
                </article>
              </li>
            </Fragment>
          ))}
        </ol>
      </section>
    </section>
  )
}

<style>
  .news-list {
    display: grid;
    /* Pin rows to their natural (auto) height instead of stretching to
       fill a taller container — e.g. when this list sits inside a bento
       tile whose height is matched to a taller sibling column, without
       this the (implicit, auto-sized) grid rows all the way down this
       component absorb the extra space and spread the entries apart. */
    align-content: start;
    gap: 1rem;
  }

  .news-list-compact {
    gap: 0.55rem;
  }

  .news-kicker {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .news-timeline-date {
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .news-list-compact .news-timeline-date {
    font-size: 0.8125rem;
  }

  .news-top-sep {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .news-card-title {
    margin: 0;
    line-height: 1.05;
    text-wrap: balance;
  }

  .news-card-title {
    font-size: 1.15rem;
  }

  .news-list-compact .news-card-title {
    font-size: 0.98rem;
  }

  .news-card-title-featured {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  .news-summary :global(p:first-child) {
    margin-top: 0;
  }

  .news-summary :global(p:last-child) {
    margin-bottom: 0;
  }

  .news-summary {
    color: hsl(var(--muted-foreground) / 1);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 68ch;
  }

  .news-summary-compact {
    font-size: 1rem;
    line-height: 1.5;
  }

  .news-list-compact .news-summary,
  .news-list-compact .news-summary-compact {
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .news-card-body {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: start;
    justify-content: space-between;
  }

  .news-card-text {
    display: grid;
    gap: 0.25rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .news-card-thumb {
    flex: none;
    width: 5.5rem;
    height: 3.6rem;
    object-fit: cover;
    border-radius: calc(1 * var(--radius, 0.5rem));
  }

  .news-list-compact .news-card-thumb {
    width: 4.2rem;
    height: 2.8rem;
  }

  @media (max-width: 480px) {
    .news-card-body {
      flex-direction: column;
    }

    .news-card-thumb {
      width: 100%;
      height: auto;
      max-height: 9rem;
    }
  }

  .news-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }

  .news-cta {
    background: hsl(var(--foreground) / 1);
    color: hsl(var(--background) / 1);
    border-color: transparent;
  }

  .news-cta :global(svg) {
    color: hsl(var(--background) / 1);
  }

  .news-timeline-section {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .news-list-compact .news-timeline-section {
    gap: 0.65rem;
  }

  .news-timeline-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: end;
    justify-content: space-between;
  }

  .news-timeline-heading h2,
  .news-timeline-heading p {
    margin: 0;
  }

  .news-timeline-heading p {
    color: hsl(var(--muted-foreground) / 1);
  }

  .news-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .news-list-compact .news-timeline {
    gap: 0.55rem;
  }

  .news-year-divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0.8rem 0 0.35rem;
    scroll-margin-top: 5rem;
    color: hsl(var(--primary) / 1);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .news-list-compact .news-year-divider {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
  }

  .news-year-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, hsl(var(--primary) / 0.3), transparent);
  }

  .news-timeline-item {
    scroll-margin-top: 5rem;
  }

  .news-timeline-card {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1rem 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid hsl(var(--border));
    background: transparent;
  }
  .news-timeline-top {
    grid-column: 1;
    align-content: start;
    flex-direction: column;
    align-items: start !important;
  }
  .news-card-body,
  .news-card-actions {
    grid-column: 2;
  }
  .news-card-body {
    grid-row: 1;
  }
  @media (max-width: 700px) {
    .news-timeline-card {
      grid-template-columns: 1fr;
    }
    .news-card-body,
    .news-card-actions,
    .news-timeline-top {
      grid-column: 1;
      grid-row: auto;
    }
  }

  .news-list-compact .news-timeline-card {
    gap: 0.5rem;
    padding: 0.75rem 0.85rem;
    border-radius: calc(1.5 * var(--radius, 0.5rem));
  }

  .news-timeline-card-featured {
    border-top: 2px solid hsl(var(--primary));
  }

  /* An inset bar (rather than border-left) so the accent stays a straight
     line instead of following the card's rounded corners. */

  .news-timeline-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .news-list-compact .news-timeline-top {
    gap: 0.45rem;
  }

  .news-timeline-top .news-tag-row {
    margin-inline-start: 0;
  }

  .news-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .news-tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0 0.65rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 0.1);
    color: hsl(var(--primary) / 1);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .news-list-compact .news-tag {
    min-height: 1.45rem;
    padding: 0 0.45rem;
    font-size: 0.8125rem;
  }

  /* Flat variant: no per-entry card chrome, divider lines between entries
     instead — used when the list is embedded inside an already-bordered
     container (homepage tile). */
  .news-list-flat .news-timeline-card {
    padding: 0.85rem 0.15rem;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  .news-list-flat .news-timeline-item:not(:last-child) .news-timeline-card {
    border-bottom: 1px solid hsl(var(--border) / 0.55);
  }

  .news-list-flat .news-timeline {
    gap: 0;
  }

  .news-list-flat .news-year-divider {
    display: none;
  }

  @media (max-width: 767px) {
    .news-year-divider {
      gap: 0.6rem;
      margin-bottom: -0.05rem;
    }
  }
</style>
