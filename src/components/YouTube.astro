---
interface Props {
  id: string
  title: string
}

const { id, title } = Astro.props
const thumbnail = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`
---

<youtube-facade class='yt-facade' data-id={id} data-title={title}>
  <button type='button' class='yt-facade-button' aria-label={`Play video: ${title}`}>
    <img src={thumbnail} alt='' loading='lazy' class='yt-facade-thumb' />
    <span class='yt-facade-play' aria-hidden='true'>
      <svg viewBox='0 0 68 48' width='68' height='48'>
        <path
          d='M66.52 7.74c-.78-2.93-2.49-5.4-5.42-6.18C55.79.13 34 0 34 0S12.21.13 6.9 1.56c-2.93.78-4.63 3.25-5.42 6.18C.13 13.05 0 24 0 24s.13 10.95 1.56 16.26c.78 2.93 2.49 5.28 5.42 6.06C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.56c2.93-.78 4.64-3.13 5.42-6.06C67.87 34.95 68 24 68 24s-.13-10.95-1.56-16.26z'
          fill='#212121'
          fill-opacity='0.8'></path>
        <path d='M45 24 27 14v20' fill='#fff'></path>
      </svg>
    </span>
  </button>
</youtube-facade>

<script>
  class YouTubeFacade extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')
      button?.addEventListener('click', () => this.load())
    }

    load() {
      const id = this.dataset.id
      const title = this.dataset.title || 'YouTube video'
      if (!id) return

      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`
      iframe.title = title
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture')
      iframe.allowFullscreen = true
      iframe.className = 'yt-facade-iframe'
      this.replaceChildren(iframe)
    }
  }

  if (!customElements.get('youtube-facade')) {
    customElements.define('youtube-facade', YouTubeFacade)
  }
</script>

<style>
  .yt-facade {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: calc(1.5 * var(--radius, 0.5rem));
    overflow: hidden;
    background: hsl(var(--muted) / 1);
  }

  .yt-facade-button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: none;
  }

  .yt-facade-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-facade-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .yt-facade-play svg {
    width: 4.2rem;
    height: auto;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.4));
    transition: transform 0.2s ease;
  }

  .yt-facade-button:hover .yt-facade-play svg,
  .yt-facade-button:focus-visible .yt-facade-play svg {
    transform: scale(1.08);
  }

  .yt-facade :global(.yt-facade-iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
