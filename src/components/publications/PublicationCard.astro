---
import type { CollectionEntry } from 'astro:content'

import { Button } from 'astro-pure/user'

interface Props {
  entry: CollectionEntry<'publications'>
  compact?: boolean
}

const { entry, compact = false } = Astro.props

const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint',
  thesis: 'Thesis',
  demo: 'Demo',
  other: 'Other'
}
const statusLabels: Record<string, string> = {
  published: 'Published',
  accepted: 'Accepted',
  submitted: 'Submitted',
  'in-revision': 'In revision',
  ongoing: 'Ongoing work'
}

const bibtexHref = `/bibtex/${entry.data.bibkey}.bib`
const detailHref = `/publications/${entry.data.bibkey}`
const recordType =
  entry.data.status === 'in-revision'
    ? 'Manuscript'
    : (typeLabels[entry.data.type] ?? entry.data.type)
---

<div
  class:list={[
    'pub-card-wrapper',
    compact && 'pub-card-wrapper-compact',
    entry.data.image && 'pub-card-wrapper-with-image'
  ]}
  data-year={entry.data.year}
  data-type={entry.data.type}
  data-reveal
>
  <article class:list={['pub-card', entry.data.featured && 'pub-card-featured']}>
    <p class='pub-venue'>{entry.data.venue}</p>
    <h2><a href={detailHref}>{entry.data.title}</a></h2>
    <p class='pub-authors'>{entry.data.authors}</p>
    {
      entry.data.image ? (
        <img src={entry.data.image} alt='' class='pub-thumb' loading='lazy' />
      ) : null
    }
    <div class='pub-meta-row'>
      <span class='pub-type-badge'>{recordType}</span>
      <span class:list={['pub-status-badge', `status-${entry.data.status}`]}
        >{statusLabels[entry.data.status]}</span
      >
      {entry.data.featured ? <span class='pub-featured-badge'>Featured</span> : null}
      {
        entry.data.citations ? (
          <span class='pub-citation-badge'>{entry.data.citations} citations</span>
        ) : null
      }
    </div>

    {
      !compact && entry.data.highlights?.length ? (
        <ul class='pub-highlights'>
          {entry.data.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      ) : null
    }

    <div class='pub-links'>
      <a class='pub-dossier-link' href={detailHref}>Open dossier →</a>
      {
        !compact && entry.data.website ? (
          <Button href={entry.data.website} target='_blank' variant='ahead' title='Project page' />
        ) : null
      }
      {
        !compact && entry.data.url ? (
          <Button href={entry.data.url} target='_blank' variant='ahead' title='Paper' />
        ) : null
      }
      {
        !compact && entry.data.pdf ? (
          <Button href={entry.data.pdf} target='_blank' variant='ahead' title='PDF' />
        ) : null
      }
      {
        !compact && entry.data.code ? (
          <Button href={entry.data.code} target='_blank' variant='ahead' title='Code' />
        ) : null
      }
      {
        !compact && entry.data.video ? (
          <Button href={entry.data.video} target='_blank' variant='ahead' title='Video' />
        ) : null
      }
      {
        !compact ? (
          <Button href={bibtexHref} download variant='ahead' title='Download .bib' />
        ) : null
      }
      {
        !compact ? (
          <Button
            as='button'
            type='button'
            data-copy-bibtex={bibtexHref}
            variant='ahead'
            title='Copy BibTeX'
          />
        ) : null
      }
    </div>
  </article>
</div>

<script>
  import '@/lib/copy-bibtex'
</script>

<style>
  .pub-card {
    padding: 1.75rem 0;
    border-top: 1px solid hsl(var(--border));
  }
  .pub-card h2 {
    margin: 0.6rem 0;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .pub-card h2 a {
    color: inherit;
  }
  .pub-card h2 a:hover {
    color: hsl(var(--primary));
  }
  .pub-venue {
    color: hsl(var(--primary));
    font-size: 0.8125rem;
    margin: 0;
  }
  .pub-authors {
    color: hsl(var(--muted-foreground));
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .pub-card :global(p) {
    font-size: 1rem;
    line-height: 1.6;
  }

  .pub-card-wrapper-compact .pub-card :global(h2) {
    font-size: 1rem;
  }

  .pub-card-wrapper-compact .pub-card :global(p) {
    font-size: 0.88rem;
  }

  .pub-card-featured {
    border-color: hsl(var(--primary) / 0.35);
    border-top-width: 2px;
  }

  .pub-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.35rem;
  }

  .pub-type-badge,
  .pub-status-badge,
  .pub-featured-badge,
  .pub-citation-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .pub-type-badge {
    background: transparent;
    border: 1px solid hsl(var(--border) / 1);
    color: hsl(var(--muted-foreground) / 1);
  }

  .pub-featured-badge {
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary) / 1);
  }

  .pub-status-badge {
    border: 1px solid hsl(var(--border));
    background: transparent;
    color: hsl(var(--muted-foreground));
  }
  .pub-status-badge.status-accepted,
  .pub-status-badge.status-in-revision {
    border-color: hsl(var(--signal) / 0.45);
    color: hsl(var(--signal));
  }

  .pub-citation-badge {
    background: transparent;
    border: 1px solid hsl(var(--border) / 1);
    color: hsl(var(--muted-foreground) / 1);
  }

  .pub-highlights {
    margin: 0.35rem 0 0;
    padding-left: 1.15rem;
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.6rem;
  }
  .pub-dossier-link {
    align-self: center;
    color: hsl(var(--primary));
    font-size: 0.84rem;
  }

  .pub-thumb {
    display: block;
    width: 100%;
    max-height: 10rem;
    object-fit: cover;
    border-radius: calc(0.75 * var(--radius, 0.5rem));
    margin: 0.5rem 0;
  }

  @media (min-width: 640px) {
    .pub-card-wrapper-with-image .pub-thumb {
      float: right;
      width: 9rem;
      height: 6rem;
      max-height: none;
      margin: 0 0 0.5rem 1rem;
      shape-outside: inset(0 round calc(1.2 * var(--radius, 0.5rem)));
    }
  }
</style>
