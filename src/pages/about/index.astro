---
import PageLayout from '@/layouts/BaseLayout.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import EditorialSection from '@/components/EditorialSection.astro'
import PageIntro from '@/components/PageIntro.astro'
import ResearchDiagram from '@/components/ResearchDiagram.astro'
import mcrtcLogo from '@/assets/tools/mcrtc.png'

import { loadCV, type CVSkill } from '../../lib/cv-data-loader.ts'

const cv = loadCV()
const githubHandle = cv.basics.github

// Same icon set as the CV page, so both pages point at the same official assets.
const skillIconMap = {
  'C++': import('@/assets/tools/cpp.svg?raw'),
  Python: import('@/assets/tools/python.svg?raw'),
  'ROS 2': import('@/assets/tools/ros2.svg?raw'),
  mc_rtc: mcrtcLogo
} as const

const skillLinkMap: Record<string, string> = {
  'C++': 'https://isocpp.org/',
  Python: 'https://www.python.org/',
  'ROS 2': 'https://www.ros.org/',
  mc_rtc: 'https://jrl-umi3218.github.io/mc_rtc/'
}

const skillDescriptionMap: Record<string, string> = {
  'C++': 'Real-time control and robotics software',
  Python: 'Data analysis, prototyping, and visualization',
  'ROS 2': 'Robotics middleware',
  mc_rtc: 'Whole-body control framework'
}

const softwareTools = (
  cv.skills?.find((skill: CVSkill) => skill.category === 'Software')?.items ?? []
)
  .filter((item: string): item is keyof typeof skillIconMap => item in skillIconMap)
  .map((item: keyof typeof skillIconMap) => ({
    name: item,
    description: skillDescriptionMap[item],
    href: skillLinkMap[item],
    icon: skillIconMap[item]
  }))
---

<PageLayout meta={{ title: 'About', ogImage: '/og/about.png' }}>
  <PageIntro
    kicker='About'
    title='Sustained physical human–robot interaction.'
    copy='My work spans online motion generation, torque control, and predictive models for collaborative manipulation.'
  />
  <EditorialSection label='01 / Profile' title='Research & background' id='profile'>
    <p>{cv.summary?.paragraph}</p>
  </EditorialSection>
  <EditorialSection label='02 / Questions' title='Research interests' id='research-interests'>
    <ul>
      <li>Sustained physical human–robot interaction and collaborative manipulation</li>
      <li>Online minimum-jerk reference generation under disturbances</li>
      <li>Torque-controlled manipulators and inverse-dynamics QP control</li>
      <li>Task-level and null-space compliance with force-aware safety constraints</li>
      <li>Predictive world models for collaborative motion and interaction forces</li>
    </ul>

    <div class='about-diagram'><ResearchDiagram /></div>
  </EditorialSection>
  <EditorialSection label='03 / Practice' title='Tools & technical stack' id='tools'>
    <p>
      Tools and environments representative of those used in my research and software development.
    </p>

    <ToolSection class='mb-5' title='Programming & Robotics' tools={softwareTools} />

    <ToolSection
      class='mb-5'
      title='Development Environment'
      tools={[
        {
          name: 'Linux (Ubuntu)',
          description: 'Primary development and experiment platform',
          href: 'https://ubuntu.com/',
          icon: import('@/assets/tools/ubuntu.svg?raw')
        },
        {
          name: 'Neovim',
          description: 'Editing, code review, and writing',
          href: 'https://neovim.io/',
          icon: import('@/assets/tools/neovim.svg?raw')
        }
      ]}
    />
  </EditorialSection>
  <EditorialSection label='04 / Connect' title='Online presence' id='online-presence'>
    <p>Public profiles and repositories related to my academic and technical work:</p>

    <a
      class='styled-link'
      href={`https://github.com/${githubHandle}`}
      target='_blank'
      rel='noreferrer'>GitHub repositories ↗</a
    >
  </EditorialSection>
</PageLayout>
<style>
  p,
  li {
    font-size: 1rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }
  ul {
    padding-left: 1.2rem;
    list-style: disc;
  }
  li {
    margin-bottom: 0.6rem;
  }
  .about-diagram {
    max-width: 32rem;
    margin-top: 2rem;
  }
</style>
