---
import { Card, Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import CVEntry from '@/components/cv/CVEntry.astro'
import mcrtcLogo from '@/assets/tools/mcrtc.png'

import { loadCV, type CVLink } from '../lib/cv-data-loader.ts'

type ContactItem =
  | { label: string; value: string; href: string }
  | { label: string; value: string }

const cv = loadCV()

const fullName = `${cv.basics.first_name} ${cv.basics.last_name}`
const links = [
  cv.basics.website ? { label: 'Website', url: cv.basics.website } : null,
  cv.basics.github ? { label: 'GitHub', url: `https://github.com/${cv.basics.github}` } : null,
  cv.basics.linkedin
    ? {
        label: 'LinkedIn',
        url: `https://www.linkedin.com/in/${cv.basics.linkedin}`
      }
    : null,
  cv.basics.scholar ? { label: 'Google Scholar', url: cv.basics.scholar } : null,
  cv.basics.orcid ? { label: 'ORCID', url: cv.basics.orcid } : null
].filter((link): link is CVLink => link !== null)

const contactItems = [
  { label: 'Email', value: cv.basics.email, href: `mailto:${cv.basics.email}` },
  cv.basics.location ? { label: 'Location', value: cv.basics.location } : null,
  cv.basics.mobile ? { label: 'Phone', value: cv.basics.mobile } : null,
  cv.basics.date_of_birth ? { label: 'Born', value: cv.basics.date_of_birth } : null
].filter((item): item is ContactItem => item !== null)

const skillIconMap = {
  'C++': import('@/assets/tools/cpp.svg?raw'),
  Python: import('@/assets/tools/python.svg?raw'),
  'ROS 2': import('@/assets/tools/ros2.svg?raw'),
  mc_rtc: mcrtcLogo,
  Linux: import('@/assets/tools/ubuntu.svg?raw')
} as const

const skillLinkMap: Record<string, string> = {
  'C++': 'https://isocpp.org/',
  Python: 'https://www.python.org/',
  'ROS 2': 'https://docs.ros.org/en/rolling/index.html',
  mc_rtc: 'https://jrl-umi3218.github.io/mc_rtc/',
  Linux: 'https://ubuntu.com/'
}

const skillDescriptionMap: Record<string, string> = {
  'C++': 'Real-time robotics software and control implementation',
  Python: 'Analysis, prototyping, and experiment tooling',
  'ROS 2': 'Middleware integration for robotic systems',
  mc_rtc: 'Whole-body and whole-system control framework',
  Linux: 'Primary research and development environment'
}

const iconSkillCategories = new Set(['Software'])

const skillSections = (cv.skills || [])
  .map((skill) => ({
    title: skill.category,
    tools: (skill.items || [])
      .filter((item) => item in skillIconMap)
      .map((item) => ({
        name: item,
        description: skillDescriptionMap[item] || skill.category,
        href: skillLinkMap[item] || '/about',
        icon: skillIconMap[item as keyof typeof skillIconMap]
      }))
  }))
  .filter((section) => iconSkillCategories.has(section.title))
  .filter((section) => section.tools.length)

const nonIconSkillSections = (cv.skills || []).filter((skill) => !iconSkillCategories.has(skill.category))

// Compact horizontal Gantt timeline: each entry is a duration bar
// (experience lane above the axis, education below). Overlapping periods
// within a lane stack into sub-rows; dates are parsed at month resolution
// and unparseable entries are skipped, never fatal.
const TIMELINE_START = 2016
const TIMELINE_END = 2027

const MONTHS: Record<string, number> = {
  jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,
  jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11
}

function parseMoment(segment: string): number | null {
  const yearMatch = segment.match(/\b(19|20)\d{2}\b/)
  if (!yearMatch) return null
  const year = Number(yearMatch[0])
  if (!Number.isFinite(year)) return null
  const monthMatch = segment
    .toLowerCase()
    .match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z.]*\b/)
  const month = monthMatch ? MONTHS[monthMatch[1]] : 0
  return year + month / 12
}

function parseRange(dates: string): { start: number; end: number; current: boolean } | null {
  const parts = dates.split(/\s*[-–]\s*/)
  const start = parseMoment(parts[0] ?? '')
  if (start === null) return null
  const current = /present/i.test(dates)
  let end: number | null
  if (current) {
    const now = new Date()
    end = now.getFullYear() + now.getMonth() / 12
  } else {
    end = parseMoment(parts[parts.length - 1] ?? '')
    if (end === null) end = start
  }
  // Cover the end month inclusively, and give very short stints a
  // readable minimum width.
  end = Math.max(end + 1 / 12, start + 3 / 12)
  return { start, end, current }
}

interface TimelineBar {
  label: string
  place: string
  dates: string
  current: boolean
  lane: 'exp' | 'edu'
  row: number
  leftPct: number
  widthPct: number
  targetId: string
}

// Abbreviates full month names to three letters for the compact tooltip
// (e.g. "February 2026 - Present" -> "Feb 2026 - Present").
function abbreviateDates(dates: string): string {
  return dates.replace(
    /\b(January|February|March|April|May|June|July|August|September|October|November|December)\b/g,
    (month) => month.slice(0, 3)
  )
}

function toBars(
  entries: {
    title?: string
    degree?: string
    organization?: string
    institution?: string
    location?: string
    short_title?: string
    short_degree?: string
    short_organization?: string
    short_institution?: string
    short_location?: string
    dates: string
  }[],
  lane: 'exp' | 'edu'
): TimelineBar[] {
  const span = TIMELINE_END - TIMELINE_START
  const parsed = entries
    .map((entry, index) => {
      const range = parseRange(entry.dates)
      if (!range) return null
      const title = entry.short_title ?? entry.title
      const degree = entry.short_degree ?? entry.degree
      const label = title ?? degree ?? ''
      const place = entry.short_organization ?? entry.organization ?? entry.short_institution ?? entry.institution ?? ''
      const location = entry.short_location ?? entry.location ?? ''
      const targetId = `${lane}-${index}`
      return { ...range, label, place, location, targetId, dates: abbreviateDates(entry.dates) }
    })
    .filter((item): item is NonNullable<typeof item> => item !== null)
    .sort((a, b) => a.start - b.start)

  // Greedy row assignment: each bar takes the first sub-row whose last
  // bar ends before this one starts, so overlapping periods stack. (This
  // only accounts for bar/time overlap — text labels are shown in a
  // floating tooltip rather than inline, precisely because label *width*
  // can't be known at build time and would collide with neighbors in ways
  // this time-based packing can't account for.)
  const rowEnds: number[] = []
  return parsed.map((item) => {
    let row = rowEnds.findIndex((endsAt) => endsAt <= item.start + 1e-6)
    if (row === -1) {
      row = rowEnds.length
      rowEnds.push(item.end)
    } else {
      rowEnds[row] = item.end
    }
    const clampedStart = Math.min(Math.max(item.start, TIMELINE_START), TIMELINE_END)
    const clampedEnd = Math.min(Math.max(item.end, TIMELINE_START), TIMELINE_END)
    const leftPct = ((clampedStart - TIMELINE_START) / span) * 100
    const widthPct = Math.max(((clampedEnd - clampedStart) / span) * 100, 0.8)
    const place = [item.place, item.location].filter(Boolean).join(', ')
    return {
      label: item.label,
      place,
      dates: item.dates,
      current: item.current,
      lane,
      row,
      leftPct,
      widthPct,
      targetId: item.targetId
    } satisfies TimelineBar
  })
}

const expBars = toBars(cv.experience || [], 'exp')
const eduBars = toBars(cv.education || [], 'edu')
const expRows = expBars.length ? Math.max(...expBars.map((bar) => bar.row)) + 1 : 0
const eduRows = eduBars.length ? Math.max(...eduBars.map((bar) => bar.row)) + 1 : 0

// Vertical geometry in rem: exp sub-rows stack upward from the axis, edu
// sub-rows downward. No space is reserved for inline labels — hover/focus
// shows a floating tooltip instead (see the script block below), which avoids
// both the clipping and label-collision problems of rendering text inline.
const BAR_H = 0.6
const ROW_STEP = 1.05
const TOP_PAD = 0.5

const axisTop = TOP_PAD + (expRows ? (expRows - 1) * ROW_STEP + BAR_H : 0)
const eduBelowHeight = eduRows ? (eduRows - 1) * ROW_STEP + BAR_H : 0
const trackHeight = axisTop + eduBelowHeight + 1.6

function barTop(bar: TimelineBar): number {
  if (bar.lane === 'exp') return axisTop - bar.row * ROW_STEP - BAR_H
  return axisTop + bar.row * ROW_STEP
}

const timelineBars = [...expBars, ...eduBars]

const timelineTicks = [2016, 2018, 2020, 2022, 2024, 2026].map((year) => ({
  year,
  percent: ((year - TIMELINE_START) / (TIMELINE_END - TIMELINE_START)) * 100
}))
---

<PageLayout meta={{ title: 'CV', ogImage: '/og/cv.png' }} highlightColor='hsl(199 89% 55%)'>
  <section class='cv-shell'>
    <section class='cv-hero'>
      <div class='cv-hero-main'>
        <p class='cv-kicker'>Curriculum Vitae</p>
        <h1 class='cv-title'>{fullName}</h1>
        <p class='cv-position'>{cv.basics.position}</p>
        <p class='cv-affiliation'>CNRS-AIST Joint Robotics Laboratory, Tsukuba, Japan</p>
        {
          cv.summary?.paragraph ? (
            <p class='cv-summary'>{cv.summary.paragraph}</p>
          ) : null
        }
      </div>

      <div class='cv-hero-side'>
        <div class='cv-actions'>
          <Button href='/cv.pdf' variant='ahead' class='cv-download' title='Download PDF' />
          {
            links.length ? (
              <div class='cv-links'>
                {links.map((link) => (
                  <a class='cv-link-pill' href={link.url} target='_blank' rel='noreferrer'>
                    {link.label}
                  </a>
                ))}
              </div>
            ) : null
          }
        </div>
        <div class='cv-facts cv-facts-grid'>
          {contactItems.map((item) => (
            <div class='cv-fact'>
              <span class='cv-fact-label'>{item.label}</span>
              {
                'href' in item ? (
                  <a href={item.href} class='styled-link'>
                    {item.value}
                  </a>
                ) : (
                  <span>{item.value}</span>
                )
              }
            </div>
          ))}
        </div>
      </div>
    </section>

    {
      /* Decorative summary strip: the same data is fully readable in the
         Experience/Education sections below, so this is hidden from
         assistive tech. Labels are NOT rendered inline — text width can't
         be known at build time, so inline labels either clipped (fixed
         positions near the container edge) or collided with neighbors
         (variable-width text placed by time position alone, independent
         of how much horizontal room neighbors need). A single floating
         tooltip (positioned by JS, viewport-clamped) sidesteps both. */
      timelineBars.length ? (
        <section class='cv-timeline' aria-hidden='true'>
          <div class='cv-timeline-track' style={`height: ${trackHeight}rem`}>
            {timelineTicks.map((tick) => (
              <span class='cv-timeline-grid' style={`left: ${tick.percent}%`}>
                <span class='cv-timeline-year'>{tick.year}</span>
              </span>
            ))}
            <div class='cv-timeline-axis' style={`top: ${axisTop}rem`} />
            {timelineBars.map((bar) => (
              <span
                class:list={[
                  'cv-timeline-bar',
                  `cv-timeline-bar-${bar.lane}`,
                  bar.current && 'cv-timeline-bar-current'
                ]}
                style={`left: ${bar.leftPct}%; width: ${bar.widthPct}%; top: ${barTop(bar)}rem`}
                data-timeline-label={[bar.label, bar.place, bar.dates].filter(Boolean).join(' · ')}
                data-timeline-target={bar.targetId}
              />
            ))}
          </div>
          <p class='cv-timeline-legend'>
            <span class='cv-timeline-legend-dot cv-timeline-legend-exp' /> Experience
            <span class='cv-timeline-legend-dot cv-timeline-legend-edu' /> Education
          </p>
          <div id='cv-timeline-tooltip' class='cv-timeline-tooltip' role='presentation'></div>
        </section>
      ) : null
    }

    {
      cv.experience?.length ? (
        <section class='cv-section'>
          <div class='cv-section-header'>
            <p class='cv-section-kicker'>Career</p>
            <h2>Experience</h2>
          </div>
          <div class='cv-stack'>
            {cv.experience.map((entry, index) => {
              const current = entry.dates.includes('Present')
              return (
                <CVEntry
                  id={`exp-${index}`}
                  title={entry.title}
                  subtitle={`${entry.organization} · ${entry.location}`}
                  dates={entry.dates}
                  current={current}
                >
                  {entry.items?.length ? (
                    <ul>
                      {entry.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ) : null}
                </CVEntry>
              )
            })}
          </div>
        </section>
      ) : null
    }

    {
      cv.education?.length ? (
        <section class='cv-section'>
          <div class='cv-section-header'>
            <p class='cv-section-kicker'>Academic background</p>
            <h2>Education</h2>
          </div>
          <div class='cv-stack'>
            {cv.education.map((entry, index) => (
              <CVEntry
                id={`edu-${index}`}
                title={`${entry.degree}${entry.area ? ` — ${entry.area}` : ''}`}
                subtitle={`${entry.institution} · ${entry.location}`}
                dates={entry.dates}
                compact
              >
                {entry.items?.length ? (
                  <ul>
                    {entry.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                ) : null}
              </CVEntry>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      skillSections.length || nonIconSkillSections.length ? (
        <section class='cv-section'>
          <div class='cv-section-header'>
            <p class='cv-section-kicker'>Toolbox</p>
            <h2>Skills</h2>
          </div>
          <div class='cv-tools'>
            {nonIconSkillSections.map((skill) => (
              <Card heading={skill.category} class='cv-card'>
                <div class='cv-skill-grid'>
                  {(skill.items || []).map((item) => (
                    <span class='cv-skill-tile'>{item}</span>
                  ))}
                </div>
              </Card>
            ))}
            {skillSections.map((section) => (
              <ToolSection title={section.title} tools={section.tools} />
            ))}
          </div>
        </section>
      ) : null
    }
  </section>
</PageLayout>

<script>
  // Floating tooltip for the CV timeline bars. Positioned via JS
  // (position: fixed, clamped to the viewport) rather than pure CSS
  // absolute-positioning, which is what let it clip against the
  // scrolling track's edges and what made avoiding overlap with
  // neighboring bars' labels intractable without knowing rendered text
  // width. Document-delegated so it keeps working across view-transition
  // navigations without re-registering listeners.
  function initTimelineTooltip() {
    // Guard on <html>, not the tooltip element itself: under view
    // transitions the tooltip div is recreated fresh on every navigation
    // to /cv, so a flag on it would never prevent re-adding these
    // document-level listeners on repeat visits to this page.
    if (document.documentElement.dataset.cvTimelineTooltipInit) return
    document.documentElement.dataset.cvTimelineTooltipInit = 'true'

    const show = (bar: HTMLElement) => {
      const tooltip = document.getElementById('cv-timeline-tooltip')
      const label = bar.dataset.timelineLabel
      if (!tooltip || !label) return
      tooltip.textContent = label
      tooltip.classList.add('is-visible')

      const barRect = bar.getBoundingClientRect()
      const tipRect = tooltip.getBoundingClientRect()
      const margin = 8

      let left = barRect.left + barRect.width / 2 - tipRect.width / 2
      left = Math.min(Math.max(left, margin), window.innerWidth - tipRect.width - margin)

      let top = barRect.top - tipRect.height - margin
      if (top < margin) top = barRect.bottom + margin

      tooltip.style.left = `${left}px`
      tooltip.style.top = `${top}px`
    }

    const hide = () => document.getElementById('cv-timeline-tooltip')?.classList.remove('is-visible')

    document.addEventListener('pointerover', (event) => {
      const bar = (event.target as HTMLElement)?.closest<HTMLElement>('.cv-timeline-bar')
      if (bar) show(bar)
    })
    document.addEventListener('pointerout', (event) => {
      const bar = (event.target as HTMLElement)?.closest<HTMLElement>('.cv-timeline-bar')
      if (bar) hide()
    })
    document.addEventListener('scroll', hide, true)

    document.addEventListener('click', (event) => {
      const bar = (event.target as HTMLElement)?.closest<HTMLElement>('.cv-timeline-bar')
      const targetId = bar?.dataset.timelineTarget
      const target = targetId ? document.getElementById(targetId) : null
      if (!target) return
      target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      target.classList.add('cv-entry-flash')
      setTimeout(() => target.classList.remove('cv-entry-flash'), 1200)
    })
  }

  initTimelineTooltip()
  document.addEventListener('astro:page-load', initTimelineTooltip)
</script>

<style>
  .cv-shell {
    display: grid;
    gap: 2.75rem;
    max-width: 78rem;
    margin: 0 auto;
    padding-top: 0.75rem;
  }

  .cv-hero,
  .cv-panel {
    border: 1px solid hsl(var(--border) / 1);
    background:
      radial-gradient(circle at top right, hsl(var(--primary) / 0.16), transparent 45%),
      linear-gradient(180deg, hsl(var(--background) / 0.98), hsl(var(--muted) / 0.92));
    box-shadow: 0 20px 45px -40px rgba(15, 23, 42, 0.45);
  }

  .cv-hero {
    display: grid;
    gap: 1.4rem;
    padding: 2rem;
    border-radius: 1.9rem;
  }

  .cv-hero-main,
  .cv-hero-side {
    display: grid;
    align-content: start;
  }

  .cv-hero-main {
    gap: 1rem;
  }

  .cv-hero-side {
    gap: 1.1rem;
  }

  .cv-kicker {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .cv-title,
  .cv-position,
  .cv-affiliation,
  .cv-summary,
  .cv-section-header h2,
  .cv-entry-top h3,
  .cv-skill-block h3 {
    margin: 0;
  }

  .cv-title {
    font-size: clamp(2.6rem, 6.4vw, 4.8rem);
    line-height: 0.92;
    max-width: 10ch;
  }

  .cv-position {
    font-size: 1.22rem;
    font-weight: 700;
  }

  .cv-affiliation,
  .cv-summary,
  .cv-entry-meta,
  .cv-entry-location,
  .cv-entry-date,
  .cv-fact-label {
    color: hsl(var(--muted-foreground) / 1);
  }

  .cv-summary {
    max-width: 46rem;
    font-size: 1.06rem;
    line-height: 1.9;
  }

  .cv-actions {
    display: grid;
    gap: 1rem;
    margin-top: 0;
  }

  .cv-download {
    width: fit-content;
    background: hsl(var(--foreground) / 1);
    color: hsl(var(--background) / 1);
    border-color: transparent;
  }

  .cv-download :global(svg) {
    color: hsl(var(--background) / 1);
  }

  .cv-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .cv-link-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 1);
    background: hsl(var(--background) / 0.94);
    text-decoration: none;
    color: inherit;
    font-size: 0.84rem;
  }

  .cv-skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }

  .cv-skill-tile {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.75rem 0.9rem 0.75rem 1.05rem;
    border-radius: 1rem;
    border: 1px solid hsl(var(--border) / 1);
    background:
      linear-gradient(180deg, hsl(var(--background) / 0.98), hsl(var(--muted) / 0.88));
    box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.04);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    color: inherit;
  }

  .cv-skill-tile::before {
    content: '';
    position: absolute;
    left: 0.4rem;
    top: 0.65rem;
    bottom: 0.65rem;
    width: 2px;
    border-radius: 2px;
    background: hsl(var(--primary) / 0.5);
  }

  .cv-link-pill:hover {
    color: hsl(var(--primary) / 1);
    border-color: hsl(var(--primary) / 0.35);
  }

  .cv-facts,
  .cv-stack {
    display: grid;
    gap: 1.1rem;
    margin-top: 1rem;
  }

  .cv-tools {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .cv-facts-grid {
    grid-template-columns: 1fr;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: 1rem;
    background: hsl(var(--background) / 0.45);
  }

  .cv-fact {
    display: grid;
    gap: 0.15rem;
  }

  .cv-fact-label {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cv-section {
    display: grid;
    gap: 1.15rem;
  }

  .cv-section-header {
    display: grid;
    gap: 0.3rem;
  }

  .cv-section-kicker {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .cv-section-header h2 {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 1.7rem;
    line-height: 1.05;
  }

  .cv-section-header h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, hsl(var(--primary) / 0.3), transparent);
  }

  .cv-card :global(ul) {
    margin: 0;
  }

  .cv-card :global(h2) {
    font-size: 1.1rem;
  }

  .cv-card :global(p) {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .cv-timeline {
    overflow-x: auto;
    padding: 0.25rem;
  }

  .cv-timeline-track {
    position: relative;
    min-width: 40rem;
    margin: 0 1.25rem;
  }

  .cv-timeline-axis {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      hsl(var(--border) / 0.4),
      hsl(var(--border) / 1) 12%,
      hsl(var(--border) / 1) 88%,
      hsl(var(--border) / 0.4)
    );
  }

  /* Faint vertical gridline per tick year, spanning the whole strip,
     with its year label at the bottom. */
  .cv-timeline-grid {
    position: absolute;
