---
import { Card, Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import CVEntry from '@/components/cv/CVEntry.astro'
import mcrtcLogo from '@/assets/tools/mcrtc.png'

import { loadCV, type CVLink } from '../lib/cv-data-loader.ts'

type ContactItem =
  | { label: string; value: string; href: string }
  | { label: string; value: string }

const cv = loadCV()

const fullName = `${cv.basics.first_name} ${cv.basics.last_name}`
const links = [
  cv.basics.website ? { label: 'Website', url: cv.basics.website } : null,
  cv.basics.github ? { label: 'GitHub', url: `https://github.com/${cv.basics.github}` } : null,
  cv.basics.linkedin
    ? {
        label: 'LinkedIn',
        url: `https://www.linkedin.com/in/${cv.basics.linkedin}`
      }
    : null,
  cv.basics.scholar ? { label: 'Google Scholar', url: cv.basics.scholar } : null,
  cv.basics.orcid ? { label: 'ORCID', url: cv.basics.orcid } : null
].filter((link): link is CVLink => link !== null)

const contactItems = [
  { label: 'Email', value: cv.basics.email, href: `mailto:${cv.basics.email}` },
  cv.basics.location ? { label: 'Location', value: cv.basics.location } : null,
  cv.basics.mobile ? { label: 'Phone', value: cv.basics.mobile } : null,
  cv.basics.date_of_birth ? { label: 'Born', value: cv.basics.date_of_birth } : null
].filter((item): item is ContactItem => item !== null)

const skillIconMap = {
  'C++': import('@/assets/tools/cpp.svg?raw'),
  Python: import('@/assets/tools/python.svg?raw'),
  'ROS 2': import('@/assets/tools/ros2.svg?raw'),
  mc_rtc: mcrtcLogo,
  Linux: import('@/assets/tools/ubuntu.svg?raw')
} as const

const skillLinkMap: Record<string, string> = {
  'C++': 'https://isocpp.org/',
  Python: 'https://www.python.org/',
  'ROS 2': 'https://docs.ros.org/en/rolling/index.html',
  mc_rtc: 'https://jrl-umi3218.github.io/mc_rtc/',
  Linux: 'https://ubuntu.com/'
}

const skillDescriptionMap: Record<string, string> = {
  'C++': 'Real-time robotics software and control implementation',
  Python: 'Analysis, prototyping, and experiment tooling',
  'ROS 2': 'Middleware integration for robotic systems',
  mc_rtc: 'Whole-body and whole-system control framework',
  Linux: 'Primary research and development environment'
}

const iconSkillCategories = new Set(['Software'])

const skillSections = (cv.skills || [])
  .map((skill) => ({
    title: skill.category,
    tools: (skill.items || [])
      .filter((item) => item in skillIconMap)
      .map((item) => ({
        name: item,
        description: skillDescriptionMap[item] || skill.category,
        href: skillLinkMap[item] || '/about',
        icon: skillIconMap[item as keyof typeof skillIconMap]
      }))
  }))
  .filter((section) => iconSkillCategories.has(section.title))
  .filter((section) => section.tools.length)

const nonIconSkillSections = (cv.skills || []).filter((skill) => !iconSkillCategories.has(skill.category))

// Compact horizontal timeline: dots-only (labels appear on hover), split
// into an experience lane above the axis and an education lane below it.
// Start dates are parsed at month resolution so same-year entries spread
// out instead of stacking; unparseable dates are skipped, never fatal.
const TIMELINE_START = 2016
const TIMELINE_END = 2027

interface TimelineMarker {
  label: string
  year: number
  current: boolean
  percent: number
  lane: 'exp' | 'edu'
}

const MONTHS: Record<string, number> = {
  jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,
  jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11
}

function parseStart(dates: string): number | null {
  const yearMatch = dates.match(/\b(19|20)\d{2}\b/)
  if (!yearMatch) return null
  const year = Number(yearMatch[0])
  if (!Number.isFinite(year)) return null
  const monthMatch = dates.toLowerCase().match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z.]*\b/)
  const month = monthMatch ? MONTHS[monthMatch[1]] : 0
  return year + month / 12
}

function toMarkers(
  entries: { title?: string; degree?: string; area?: string; dates: string }[],
  lane: 'exp' | 'edu'
): TimelineMarker[] {
  return entries
    .map((entry) => {
      const start = parseStart(entry.dates)
      if (start === null) return null
      const label = entry.title ?? [entry.degree, entry.area].filter(Boolean).join(' — ') ?? ''
      const clamped = Math.min(Math.max(start, TIMELINE_START), TIMELINE_END)
      const percent = ((clamped - TIMELINE_START) / (TIMELINE_END - TIMELINE_START)) * 100
      return {
        label,
        year: Math.floor(start),
        current: entry.dates.includes('Present'),
        percent,
        lane
      }
    })
    .filter((marker): marker is TimelineMarker => marker !== null)
}

const timelineMarkers = [
  ...toMarkers(cv.experience || [], 'exp'),
  ...toMarkers(cv.education || [], 'edu')
].sort((a, b) => a.percent - b.percent)

const timelineTicks = [2016, 2018, 2020, 2022, 2024, 2026].map((year) => ({
  year,
  percent: ((year - TIMELINE_START) / (TIMELINE_END - TIMELINE_START)) * 100
}))
---

<PageLayout meta={{ title: 'CV', ogImage: '/og/cv.png' }} highlightColor='hsl(199 89% 55%)'>
  <section class='cv-shell'>
    <section class='cv-hero'>
      <div class='cv-hero-main'>
        <p class='cv-kicker'>Curriculum Vitae</p>
        <h1 class='cv-title'>{fullName}</h1>
        <p class='cv-position'>{cv.basics.position}</p>
        <p class='cv-affiliation'>CNRS-AIST Joint Robotics Laboratory, Tsukuba, Japan</p>
        {
          cv.summary?.paragraph ? (
            <p class='cv-summary'>{cv.summary.paragraph}</p>
          ) : null
        }
      </div>

      <div class='cv-hero-side'>
        <div class='cv-actions'>
          <Button href='/cv.pdf' variant='ahead' class='cv-download' title='Download PDF' />
          {
            links.length ? (
              <div class='cv-links'>
                {links.map((link) => (
                  <a class='cv-link-pill' href={link.url} target='_blank' rel='noreferrer'>
                    {link.label}
                  </a>
                ))}
              </div>
            ) : null
          }
        </div>
        <div class='cv-facts cv-facts-grid'>
          {contactItems.map((item) => (
            <div class='cv-fact'>
              <span class='cv-fact-label'>{item.label}</span>
              {
                'href' in item ? (
                  <a href={item.href} class='styled-link'>
                    {item.value}
                  </a>
                ) : (
                  <span>{item.value}</span>
                )
              }
            </div>
          ))}
        </div>
      </div>
    </section>

    {
      /* Decorative summary strip: the same data is fully readable in the
         Experience/Education sections below, so this is hidden from
         assistive tech rather than duplicating it in a hard-to-navigate
         form. Labels appear on hover. */
      timelineMarkers.length ? (
        <section class='cv-timeline' aria-hidden='true'>
          <div class='cv-timeline-track'>
            <div class='cv-timeline-axis' />
            {timelineTicks.map((tick) => (
              <span class='cv-timeline-tick' style={`left: ${tick.percent}%`}>
                {tick.year}
              </span>
            ))}
            {timelineMarkers.map((marker) => (
              <span
                class:list={[
                  'cv-timeline-marker',
                  `cv-timeline-marker-${marker.lane}`,
                  marker.current && 'cv-timeline-marker-current'
                ]}
                style={`left: ${marker.percent}%`}
                data-label={`${marker.label} · ${marker.year}`}
              />
            ))}
          </div>
          <p class='cv-timeline-legend'>
            <span class='cv-timeline-legend-dot cv-timeline-legend-exp' /> Experience
            <span class='cv-timeline-legend-dot cv-timeline-legend-edu' /> Education
          </p>
        </section>
      ) : null
    }

    {
      cv.experience?.length ? (
        <section class='cv-section'>
          <div class='cv-section-header'>
            <p class='cv-section-kicker'>Career</p>
            <h2>Experience</h2>
          </div>
          <div class='cv-stack'>
            {cv.experience.map((entry) => {
              const current = entry.dates.includes('Present')
              return (
                <CVEntry
                  title={entry.title}
                  subtitle={`${entry.organization} · ${entry.location}`}
                  dates={entry.dates}
                  current={current}
                >
                  {entry.items?.length ? (
                    <ul>
                      {entry.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ) : null}
                </CVEntry>
              )
            })}
          </div>
        </section>
      ) : null
    }

    {
      cv.education?.length ? (
        <section class='cv-section'>
          <div class='cv-section-header'>
            <p class='cv-section-kicker'>Academic background</p>
            <h2>Education</h2>
          </div>
          <div class='cv-stack'>
            {cv.education.map((entry) => (
              <CVEntry
                title={`${entry.degree}${entry.area ? ` — ${entry.area}` : ''}`}
                subtitle={`${entry.institution} · ${entry.location}`}
                dates={entry.dates}
                compact
              >
                {entry.items?.length ? (
                  <ul>
                    {entry.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                ) : null}
              </CVEntry>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      skillSections.length || nonIconSkillSections.length ? (
        <section class='cv-section'>
          <div class='cv-section-header'>
            <p class='cv-section-kicker'>Toolbox</p>
            <h2>Skills</h2>
          </div>
          <div class='cv-tools'>
            {nonIconSkillSections.map((skill) => (
              <Card heading={skill.category} class='cv-card'>
                <div class='cv-skill-grid'>
                  {(skill.items || []).map((item) => (
                    <span class='cv-skill-tile'>{item}</span>
                  ))}
                </div>
              </Card>
            ))}
            {skillSections.map((section) => (
              <ToolSection title={section.title} tools={section.tools} />
            ))}
          </div>
        </section>
      ) : null
    }
  </section>
</PageLayout>

<style>
  .cv-shell {
    display: grid;
    gap: 2.75rem;
    max-width: 78rem;
    margin: 0 auto;
    padding-top: 0.75rem;
  }

  .cv-hero,
  .cv-panel {
    border: 1px solid hsl(var(--border) / 1);
    background:
      radial-gradient(circle at top right, hsl(var(--primary) / 0.16), transparent 45%),
      linear-gradient(180deg, hsl(var(--background) / 0.98), hsl(var(--muted) / 0.92));
    box-shadow: 0 20px 45px -40px rgba(15, 23, 42, 0.45);
  }

  .cv-hero {
    display: grid;
    gap: 1.4rem;
    padding: 2rem;
    border-radius: 1.9rem;
  }

  .cv-hero-main,
  .cv-hero-side {
    display: grid;
    align-content: start;
  }

  .cv-hero-main {
    gap: 1rem;
  }

  .cv-hero-side {
    gap: 1.1rem;
  }

  .cv-kicker {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .cv-title,
  .cv-position,
  .cv-affiliation,
  .cv-summary,
  .cv-section-header h2,
  .cv-entry-top h3,
  .cv-skill-block h3 {
    margin: 0;
  }

  .cv-title {
    font-size: clamp(2.6rem, 6.4vw, 4.8rem);
    line-height: 0.92;
    max-width: 10ch;
  }

  .cv-position {
    font-size: 1.22rem;
    font-weight: 700;
  }

  .cv-affiliation,
  .cv-summary,
  .cv-entry-meta,
  .cv-entry-location,
  .cv-entry-date,
  .cv-fact-label {
    color: hsl(var(--muted-foreground) / 1);
  }

  .cv-summary {
    max-width: 46rem;
    font-size: 1.06rem;
    line-height: 1.9;
  }

  .cv-actions {
    display: grid;
    gap: 1rem;
    margin-top: 0;
  }

  .cv-download {
    width: fit-content;
    background: hsl(var(--foreground) / 1);
    color: hsl(var(--background) / 1);
    border-color: transparent;
  }

  .cv-download :global(svg) {
    color: hsl(var(--background) / 1);
  }

  .cv-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .cv-link-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 1);
    background: hsl(var(--background) / 0.94);
    text-decoration: none;
    color: inherit;
    font-size: 0.84rem;
  }

  .cv-skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }

  .cv-skill-tile {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.75rem 0.9rem 0.75rem 1.05rem;
    border-radius: 1rem;
    border: 1px solid hsl(var(--border) / 1);
    background:
      linear-gradient(180deg, hsl(var(--background) / 0.98), hsl(var(--muted) / 0.88));
    box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.04);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    color: inherit;
  }

  .cv-skill-tile::before {
    content: '';
    position: absolute;
    left: 0.4rem;
    top: 0.65rem;
    bottom: 0.65rem;
    width: 2px;
    border-radius: 2px;
    background: hsl(var(--primary) / 0.5);
  }

  .cv-link-pill:hover {
    color: hsl(var(--primary) / 1);
    border-color: hsl(var(--primary) / 0.35);
  }

  .cv-facts,
  .cv-stack {
    display: grid;
    gap: 1.1rem;
    margin-top: 1rem;
  }

  .cv-tools {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .cv-facts-grid {
    grid-template-columns: 1fr;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: 1rem;
    background: hsl(var(--background) / 0.45);
  }

  .cv-fact {
    display: grid;
    gap: 0.15rem;
  }

  .cv-fact-label {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cv-section {
    display: grid;
    gap: 1.15rem;
  }

  .cv-section-header {
    display: grid;
    gap: 0.3rem;
  }

  .cv-section-kicker {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .cv-section-header h2 {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 1.7rem;
    line-height: 1.05;
  }

  .cv-section-header h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, hsl(var(--primary) / 0.3), transparent);
  }

  .cv-card :global(ul) {
    margin: 0;
  }

  .cv-card :global(h2) {
    font-size: 1.1rem;
  }

  .cv-card :global(p) {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .cv-timeline {
    overflow-x: auto;
    padding: 0.25rem;
  }

  .cv-timeline-track {
    position: relative;
    min-width: 40rem;
    height: 4.2rem;
    margin: 0 1.25rem;
  }

  .cv-timeline-axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: linear-gradient(
      90deg,
      hsl(var(--border) / 0.4),
      hsl(var(--border) / 1) 12%,
      hsl(var(--border) / 1) 88%,
      hsl(var(--border) / 0.4)
    );
  }

  .cv-timeline-tick {
    position: absolute;
    top: calc(50% + 0.55rem);
    transform: translateX(-50%);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: hsl(var(--muted-foreground) / 0.75);
    font-variant-numeric: tabular-nums;
  }

  .cv-timeline-tick::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -0.55rem;
    width: 1px;
    height: 0.35rem;
    background: hsl(var(--border) / 1);
  }

  .cv-timeline-marker {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    transform: translateX(-50%);
    cursor: default;
    z-index: 1;
  }

  /* Experience lane sits above the axis, education below it. */
  .cv-timeline-marker-exp {
    top: calc(50% - 1.1rem);
    background: hsl(var(--primary) / 0.85);
    border: 2px solid hsl(var(--background) / 1);
  }

  .cv-timeline-marker-edu {
    top: calc(50% + 0.45rem);
    background: hsl(var(--background) / 1);
    border: 2px solid hsl(var(--muted-foreground) / 0.8);
  }

  .cv-timeline-marker-current {
    background: hsl(var(--primary) / 1);
    box-shadow: 0 0 0 4px hsl(var(--primary) / 0.18);
  }

  /* Connector stem from each dot to the axis. */
  .cv-timeline-marker::before {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    background: hsl(var(--border) / 0.9);
  }

  .cv-timeline-marker-exp::before {
    top: 100%;
    height: 0.45rem;
  }

  .cv-timeline-marker-edu::before {
    bottom: 100%;
    height: 0.25rem;
  }

  /* Hover label */
  .cv-timeline-marker::after {
    content: attr(data-label);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0.3rem 0.6rem;
    border-radius: calc(1.2 * var(--radius, 0.5rem));
    border: 1px solid hsl(var(--border) / 1);
    background: hsl(var(--background) / 1);
    color: hsl(var(--foreground) / 1);
    font-size: 0.74rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 2;
  }

  .cv-timeline-marker-exp::after {
    bottom: calc(100% + 0.45rem);
  }

  .cv-timeline-marker-edu::after {
    top: calc(100% + 0.45rem);
  }

  .cv-timeline-marker:hover::after {
    opacity: 1;
  }

  /* Keep edge tooltips inside the track. */
  .cv-timeline-marker:first-of-type::after {
    left: 0;
    transform: none;
  }

  .cv-timeline-marker:last-of-type::after {
    left: auto;
    right: 0;
    transform: none;
  }

  .cv-timeline-legend {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    justify-content: end;
    margin: 0.35rem 1.25rem 0;
    font-size: 0.72rem;
    color: hsl(var(--muted-foreground) / 0.85);
  }

  .cv-timeline-legend-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
  }

  .cv-timeline-legend-exp {
    background: hsl(var(--primary) / 0.85);
  }

  .cv-timeline-legend-edu {
    background: hsl(var(--background) / 1);
    border: 2px solid hsl(var(--muted-foreground) / 0.8);
  }

  .cv-timeline-legend-dot + .cv-timeline-legend-dot,
  .cv-timeline-legend-edu {
    margin-left: 0.5rem;
  }

  @media (min-width: 900px) {
    .cv-hero {
      grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.85fr);
      align-items: start;
    }
  }

  @media (max-width: 639px) {
    .cv-shell {
      gap: 2rem;
      padding-top: 0.25rem;
    }

    .cv-hero,
    .cv-panel {
      padding: 1rem;
      border-radius: 1.05rem;
    }
  }
</style>
