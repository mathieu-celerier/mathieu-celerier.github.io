---
import fs from 'node:fs'
import path from 'node:path'
import { getCollection } from 'astro:content'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ResearchPlate from '@/components/ResearchPlate.astro'
import YouTube from '@/components/YouTube.astro'

export async function getStaticPaths() {
  const entries = await getCollection('publications')
  return entries.map((entry) => ({ params: { slug: entry.data.bibkey }, props: { entry } }))
}

const { entry } = Astro.props
const allEntries = await getCollection('publications')
const related = allEntries
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 2)
const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint',
  thesis: 'Thesis',
  demo: 'Demo',
  other: 'Other'
}
const bibtexPath = path.join(process.cwd(), 'public', 'bibtex', `${entry.data.bibkey}.bib`)
const bibtexHref = `/bibtex/${entry.data.bibkey}.bib`
const risHref = `/citations/${entry.data.bibkey}.ris`
const bibtexSource = fs.existsSync(bibtexPath) ? fs.readFileSync(bibtexPath, 'utf8') : null

function youtubeId(url: string): string | null {
  try {
    const parsed = new URL(url)
    if (parsed.hostname.includes('youtu.be')) return parsed.pathname.slice(1) || null
    if (parsed.hostname.includes('youtube.com')) return parsed.searchParams.get('v')
  } catch {}
  return null
}

const ytId = entry.data.video ? youtubeId(entry.data.video) : null
const visualMode =
  entry.data.bibkey === 'celerier2025explicit'
    ? 'control'
    : entry.data.bibkey === 'muraccioliDemonstratingControlFramework2025'
      ? 'system'
      : entry.data.bibkey === 'cariou2025safe'
        ? 'control'
        : 'motion'
const metaDescription = entry.data.abstract
  ? `${entry.data.abstract.slice(0, 156).trimEnd()}…`
  : `${entry.data.authors}. ${entry.data.venue ?? typeLabels[entry.data.type]}, ${entry.data.year}.`
const statusLabels: Record<string, string> = {
  published: 'Published',
  accepted: 'Accepted',
  submitted: 'Submitted',
  'in-revision': 'Manuscript in revision',
  ongoing: 'Ongoing work'
}
const recordType =
  entry.data.status === 'in-revision'
    ? 'Manuscript'
    : (typeLabels[entry.data.type] ?? entry.data.type)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: entry.data.title,
  author: entry.data.authors.split(', ').map((name: string) => ({ '@type': 'Person', name })),
  datePublished: String(entry.data.year),
  description: entry.data.abstract ?? metaDescription,
  identifier: entry.data.doi ?? entry.data.bibkey,
  url: entry.data.url ?? `https://mathieu-celerier.github.io/publications/${entry.data.bibkey}`,
  sameAs: entry.data.url,
  isPartOf: entry.data.venue ? { '@type': 'Periodical', name: entry.data.venue } : undefined
}
const scholarlyMeta = {
  title: entry.data.title,
  authors: entry.data.authors.split(', '),
  year: String(entry.data.year),
  venue: entry.data.venue,
  doi: entry.data.doi,
  pdf: entry.data.pdf
}
---

<PageLayout
  meta={{
    title: entry.data.title,
    description: metaDescription,
    ogImage: `/og/publications/${entry.data.bibkey}.png`
  }}
  {structuredData}
  {scholarlyMeta}
  highlightColor='hsl(var(--primary))'
>
  <article class='pub-detail'>
    <a class='back-link' href='/publications'>← All publications</a>

    <header class='pub-header'>
      <div class='header-main'>
        <p class='pub-kicker'>
          {
            entry.data.status === 'published'
              ? entry.data.venue || typeLabels[entry.data.type]
              : statusLabels[entry.data.status]
          }
        </p>
        <h1>{entry.data.title}</h1>
        <p class='authors'>{entry.data.authors}</p>
        <div class='badges'>
          <span>{recordType}</span><span>{entry.data.year}</span>
          <span class:list={['status-badge', `status-${entry.data.status}`]}
            >{statusLabels[entry.data.status]}</span
          >
          {entry.data.featured ? <strong>Selected contribution</strong> : null}
        </div>
      </div>
      <aside class='citation-card'>
        <span>Citation key</span><code>{entry.data.bibkey}</code>
        {
          entry.data.doi ? (
            <a href={`https://doi.org/${entry.data.doi}`} target='_blank' rel='noreferrer'>
              DOI {entry.data.doi} ↗
            </a>
          ) : null
        }
      </aside>
    </header>

    <ResearchPlate mode={visualMode} label={entry.data.title} />

    {
      entry.data.highlights?.length ? (
        <section class='contribution-section'>
          <header>
            <>
              <p>Contribution</p>
              <h2>What this work adds.</h2>
            </>
          </header>
          <ol>
            {entry.data.highlights.map((highlight, index) => (
              <li>
                <span>0{index + 1}</span>
                <p>{highlight}</p>
              </li>
            ))}
          </ol>
        </section>
      ) : null
    }

    <section class='body-grid'>
      <div class='body-main'>
        {
          entry.data.abstract ? (
            <section class='detail-section'>
              <p class='section-label'>Abstract</p>
              <h2>The research in detail.</h2>
              <p class='abstract'>{entry.data.abstract}</p>
            </section>
          ) : (
            <section class='detail-section pending-detail'>
              <p class='section-label'>Record</p>
              <h2>Publication metadata.</h2>
              <p>
                This entry currently contains the bibliographic record. Follow the available
                resources for the complete work.
              </p>
            </section>
          )
        }
        {
          ytId ? (
            <section class='detail-section'>
              <>
                <p class='section-label'>Video</p>
                <h2>Watch the work.</h2>
                <div class='video'>
                  <YouTube id={ytId} title={entry.data.title} />
                </div>
              </>
            </section>
          ) : null
        }
      </div>

      <aside class='resources'>
        <p class='section-label'>Resources</p>
        <h2>Open the work.</h2>
        <div>
          {
            entry.data.website ? (
              <Button
                href={entry.data.website}
                target='_blank'
                variant='ahead'
                title='Project page'
              />
            ) : null
          }
          {
            entry.data.url ? (
              <Button href={entry.data.url} target='_blank' variant='ahead' title='Paper' />
            ) : null
          }
          {
            entry.data.pdf ? (
              <Button href={entry.data.pdf} target='_blank' variant='ahead' title='PDF' />
            ) : null
          }
          {
            entry.data.code ? (
              <Button href={entry.data.code} target='_blank' variant='ahead' title='Code' />
            ) : null
          }
          {
            entry.data.video && !ytId ? (
              <Button href={entry.data.video} target='_blank' variant='ahead' title='Video' />
            ) : null
          }
          <Button href={bibtexHref} download variant='ahead' title='Download .bib' />
          <Button href={risHref} download variant='ahead' title='Download .ris' />
          <Button
            as='button'
            type='button'
            data-copy-bibtex={bibtexHref}
            variant='ahead'
            title='Copy BibTeX'
          />
        </div>
      </aside>
    </section>

    {
      related.length ? (
        <section class='related'>
          <p class='section-label'>Continue exploring</p>
          <h2>Related publications.</h2>
          <div>
            {related.map((item) => (
              <a href={`/publications/${item.data.bibkey}`}>
                <span>
                  {item.data.year} / {item.data.venue || item.data.type}
                </span>
                <strong>{item.data.title}</strong>
                <i>→</i>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      bibtexSource ? (
        <details class='bibtex-section'>
          <summary>Show BibTeX source</summary>
          <div>
            <>
              <button type='button' data-copy-bibtex={bibtexHref}>
                Copy
              </button>
              <pre>
                <code>{bibtexSource}</code>
              </pre>
            </>
          </div>
        </details>
      ) : null
    }
  </article>
</PageLayout>

<script>
  import '@/lib/copy-bibtex'
</script>

<style>
  .pub-detail {
    display: grid;
    gap: 4rem;
    min-width: 0;
    padding-top: 1rem;
  }
  .back-link {
    width: fit-content;
    color: hsl(var(--primary));
    font-size: 0.86rem;
  }
  .pub-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 3rem;
    align-items: end;
  }
  .pub-kicker,
  .section-label {
    margin: 0;
    color: hsl(var(--primary));
    font: 0.68rem/1.5 monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .pub-header h1 {
    max-width: 19ch;
    margin: 0.8rem 0 1.1rem;
    font-size: clamp(2.5rem, 5.8vw, 5.5rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .authors {
    max-width: 60rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.65;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .badges span,
  .badges strong {
    padding: 0.3rem 0.65rem;
    border: 1px solid hsl(var(--border));
    border-radius: 99px;
    font-size: 0.75rem;
  }
  .badges strong {
    border-color: hsl(var(--primary) / 0.35);
    background: hsl(var(--primary) / 0.1);
    color: hsl(var(--primary));
    font-weight: 500;
  }
  .badges .status-accepted,
  .badges .status-in-revision {
    border-color: hsl(var(--signal) / 0.45);
    color: hsl(var(--signal));
  }
  .citation-card {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 0;
    border-block: 1px solid hsl(var(--border));
  }
  .citation-card span {
    color: hsl(var(--muted-foreground));
    font: 0.62rem monospace;
    text-transform: uppercase;
  }
  .citation-card code {
    overflow-wrap: anywhere;
    font-size: 0.78rem;
  }
  .citation-card a {
    color: hsl(var(--primary));
    font-size: 0.78rem;
  }
  .contribution-section {
    display: grid;
    grid-template-columns: minmax(13rem, 0.65fr) minmax(0, 1.35fr);
    gap: 4rem;
  }
  .contribution-section header p {
    margin: 0;
    color: hsl(var(--primary));
    font: 0.68rem monospace;
    text-transform: uppercase;
  }
  .contribution-section h2,
  .detail-section h2,
  .resources h2,
  .related h2 {
    margin: 0.6rem 0 1.2rem;
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .contribution-section ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid hsl(var(--border));
  }
  .contribution-section li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .contribution-section li span {
    color: hsl(var(--primary));
    font: 0.65rem monospace;
  }
  .contribution-section li p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }
  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 5rem;
    align-items: start;
  }
  .body-main {
    display: grid;
    gap: 5rem;
  }
  .detail-section {
    padding-top: 2rem;
    border-top: 1px solid hsl(var(--border));
  }
  .abstract,
  .pending-detail > p:last-child {
    color: hsl(var(--muted-foreground));
    font-size: 1.04rem;
    line-height: 1.85;
  }
  .resources {
    position: sticky;
    top: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid hsl(var(--border));
  }
  .resources h2 {
    font-size: 1.7rem;
  }
  .resources > div {
    display: grid;
    gap: 0.6rem;
  }
  .resources :global(a),
  .resources :global(button) {
    width: 100%;
    justify-content: space-between;
  }
  .video {
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 7px;
  }
  .related {
    padding-top: 3rem;
    border-top: 1px solid hsl(var(--border));
  }
  .related > div {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid hsl(var(--border));
  }
  .related a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.7rem 1rem;
    padding: 1.2rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .related a:first-child {
    border-right: 1px solid hsl(var(--border));
  }
  .related span {
    grid-column: 1;
    color: hsl(var(--primary));
    font: 0.62rem monospace;
    text-transform: uppercase;
  }
  .related strong {
    grid-column: 1;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .related i {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    font-style: normal;
  }
  .bibtex-section {
    min-width: 0;
    border-top: 1px solid hsl(var(--border));
  }
  .bibtex-section summary {
    padding: 1rem 0;
    color: hsl(var(--primary));
    cursor: pointer;
  }
  .bibtex-section > div {
    position: relative;
    min-width: 0;
  }
  .bibtex-section button {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid hsl(var(--border));
    border-radius: 99px;
    background: hsl(var(--background));
  }
  .bibtex-section pre {
    max-width: 100%;
    margin: 0;
    padding: 3rem 1rem 1rem;
    overflow-x: auto;
    border-radius: 7px;
    background: hsl(var(--muted));
    font-size: 0.75rem;
  }
  @media (max-width: 760px) {
    .pub-detail {
      gap: 3rem;
    }
    .pub-header,
    .contribution-section,
    .body-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .pub-header h1 {
      font-size: clamp(2.2rem, 11vw, 3.5rem);
    }
    .resources {
      position: static;
      order: -1;
    }
    .related > div {
      grid-template-columns: 1fr;
    }
    .related a:first-child {
      border-right: 0;
    }
  }
</style>
