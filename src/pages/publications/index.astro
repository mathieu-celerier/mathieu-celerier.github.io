---
import { getCollection } from 'astro:content'
import { Card, Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint',
  thesis: 'Thesis',
  demo: 'Demo',
  other: 'Other'
}

const entries = (await getCollection('publications')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year
  if (Boolean(b.data.featured) !== Boolean(a.data.featured)) {
    return Number(b.data.featured) - Number(a.data.featured)
  }
  return a.data.title.localeCompare(b.data.title)
})

const groupedByYear = entries.reduce<Map<number, typeof entries>>((map, entry) => {
  const group = map.get(entry.data.year) ?? []
  group.push(entry)
  map.set(entry.data.year, group)
  return map
}, new Map())

const years = [...groupedByYear.keys()].sort((a, b) => b - a)
---

<PageLayout meta={{ title: 'Publications' }} highlightColor='#8A8A8A'>
  <section class='pub-page-intro'>
    <p class='pub-page-kicker'>Research output</p>
    <h1 class='pub-page-title'>Publications</h1>
    <p class='pub-page-copy'>Journal articles, conference papers, and other research output.</p>
  </section>

  {
    years.map((year) => (
      <section class='pub-year-section'>
        <h2 class='pub-year-heading'>{year}</h2>
        <div class='pub-stack'>
          {groupedByYear.get(year)!.map((entry) => (
            <Card
              heading={entry.data.title}
              subheading={entry.data.authors}
              date={entry.data.venue}
              class:list={['pub-card', entry.data.featured && 'pub-card-featured']}
            >
              <div class='pub-meta-row'>
                <span class='pub-type-badge'>{typeLabels[entry.data.type] ?? entry.data.type}</span>
                {entry.data.featured ? <span class='pub-featured-badge'>Featured</span> : null}
              </div>

              {
                entry.data.highlights?.length ? (
                  <ul class='pub-highlights'>
                    {entry.data.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                ) : null
              }

              <div class='pub-links'>
                {entry.data.website ? (
                  <Button href={entry.data.website} target='_blank' variant='ahead' title='Project page' />
                ) : null}
                {entry.data.url ? (
                  <Button href={entry.data.url} target='_blank' variant='ahead' title='Paper' />
                ) : null}
                {entry.data.pdf ? (
                  <Button href={entry.data.pdf} target='_blank' variant='ahead' title='PDF' />
                ) : null}
                {entry.data.code ? (
                  <Button href={entry.data.code} target='_blank' variant='ahead' title='Code' />
                ) : null}
                {entry.data.video ? (
                  <Button href={entry.data.video} target='_blank' variant='ahead' title='Video' />
                ) : null}
              </div>
            </Card>
          ))}
        </div>
      </section>
    ))
  }
</PageLayout>

<style>
  .pub-page-intro {
    display: grid;
    gap: 0.7rem;
    margin-bottom: 1.75rem;
  }

  .pub-page-kicker {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .pub-page-title {
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 4.4rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  .pub-page-copy {
    margin: 0;
    max-width: 42rem;
    font-size: 1.02rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground) / 1);
  }

  .pub-year-section {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .pub-year-section:first-of-type {
    margin-top: 0.5rem;
  }

  .pub-year-heading {
    margin: 0;
    font-size: 1.5rem;
    color: hsl(var(--primary) / 1);
  }

  .pub-stack {
    display: grid;
    gap: 1.1rem;
  }

  .pub-card :global(h2) {
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .pub-card :global(p) {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .pub-card-featured {
    border-color: hsl(var(--primary) / 0.35);
  }

  .pub-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.35rem;
  }

  .pub-type-badge,
  .pub-featured-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .pub-type-badge {
    background: hsl(var(--muted) / 1);
    color: hsl(var(--muted-foreground) / 1);
  }

  .pub-featured-badge {
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary) / 1);
  }

  .pub-highlights {
    margin: 0.35rem 0 0;
    padding-left: 1.15rem;
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.6rem;
  }
</style>
