---
import { getCollection } from 'astro:content'
import { loadCV } from '@/lib/cv-data-loader'

import PageLayout from '@/layouts/BaseLayout.astro'
import PageIntro from '@/components/PageIntro.astro'
import PublicationCard from '@/components/publications/PublicationCard.astro'

const entries = (await getCollection('publications')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year
  if (Boolean(b.data.featured) !== Boolean(a.data.featured))
    return Number(b.data.featured) - Number(a.data.featured)
  return a.data.title.localeCompare(b.data.title)
})
const featured = entries.filter((entry) => entry.data.featured)
const cv = loadCV()
const years = [...new Set(entries.map((entry) => entry.data.year))].sort((a, b) => b - a)
const grouped = years.map((year) => ({
  year,
  entries: entries.filter((entry) => entry.data.year === year)
}))
---

<PageLayout
  meta={{
    title: 'Publications',
    description:
      'Peer-reviewed work on robot motion, safe compliant control, and physical human–robot interaction.',
    ogImage: '/og/publications.png'
  }}
  highlightColor='hsl(var(--primary))'
>
  <PageIntro
    kicker='Research output'
    title='Publications and technical contributions.'
    copy='Selected work in physical human–robot interaction, constrained control, robot learning, and manipulation.'
  />

  <div class='publication-summary'>
    <div><span>Public record</span><strong>{entries.length} research records</strong></div>
    <div><span>Covered period</span><strong>{Math.min(...years)}—{Math.max(...years)}</strong></div>
    <div><span>Primary area</span><strong>Physical human–robot interaction</strong></div>
    {
      cv.basics.scholar ? (
        <a href={cv.basics.scholar} target='_blank' rel='noreferrer'>
          <>
            <span>Complete profile</span>
            <strong>Google Scholar ↗</strong>
          </>
        </a>
      ) : null
    }
  </div>

  {
    featured.length ? (
      <section class='selected'>
        <header class='section-heading'>
          <p>Selected contributions</p>
          <h2>Research in context.</h2>
        </header>
        <div class='selected-grid'>
          {featured.map((entry, index) => (
            <article data-reveal>
              <div class='selected-index'>
                0{index + 1} / {entry.data.year}
              </div>
              <p class='selected-venue'>
                {entry.data.status === 'published'
                  ? entry.data.venue || entry.data.type
                  : entry.data.status.replace('-', ' ')}
              </p>
              <h3>
                <a href={`/publications/${entry.data.bibkey}`}>{entry.data.title}</a>
              </h3>
              <p class='selected-contribution'>
                {entry.data.highlights?.[0] ?? entry.data.abstract}
              </p>
              <div class='selected-links'>
                <a href={`/publications/${entry.data.bibkey}`}>Open dossier →</a>
                {entry.data.video ? (
                  <a href={entry.data.video} target='_blank' rel='noreferrer'>
                    Video ↗
                  </a>
                ) : null}
                {entry.data.code ? (
                  <a href={entry.data.code} target='_blank' rel='noreferrer'>
                    Code ↗
                  </a>
                ) : null}
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : null
  }

  <section class='record'>
    <header class='section-heading'>
      <p>Complete record</p>
      <h2>Chronological list.</h2>
    </header>
    {
      grouped.map((group) => (
        <section class='pub-year-section'>
          <h3>{group.year}</h3>
          <div>
            {group.entries.map((entry) => (
              <PublicationCard entry={entry} compact />
            ))}
          </div>
        </section>
      ))
    }
  </section>
</PageLayout>

<style>
  .publication-summary {
    display: grid;
    grid-template-columns: 0.55fr 0.55fr 1fr 0.8fr;
    margin: 2.5rem 0 7rem;
    border-block: 1px solid hsl(var(--border));
  }
  .publication-summary > * {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
  }
  .publication-summary > * + * {
    border-left: 1px solid hsl(var(--border));
  }
  .publication-summary span,
  .section-heading p,
  .selected-index {
    color: hsl(var(--primary));
    font: 0.65rem/1.4 monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .publication-summary strong {
    font-size: 0.82rem;
    font-weight: 500;
  }
  .section-heading {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 2rem;
  }
  .section-heading p {
    margin: 0;
  }
  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .selected-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid hsl(var(--border));
  }
  .selected-grid article {
    min-height: 27rem;
    padding: 1.5rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .selected-grid article:nth-child(odd) {
    border-right: 1px solid hsl(var(--border));
  }
  .selected-venue {
    margin: 4rem 0 0.8rem;
    color: hsl(var(--primary));
    font-size: 0.78rem;
    text-transform: uppercase;
  }
  .selected-grid h3 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.7rem);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: -0.04em;
  }
  .selected-grid h3 a {
    color: inherit;
  }
  .selected-contribution {
    max-width: 35rem;
    margin-top: 1.2rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.65;
  }
  .selected-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2rem;
    font-size: 0.82rem;
  }
  .selected-links a {
    color: hsl(var(--primary));
  }
  .record {
    padding-top: 8rem;
  }
  .pub-year-section {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .pub-year-section > h3 {
    margin: 1.75rem 0 0;
    color: hsl(var(--primary));
    font-size: 1rem;
    font-weight: 500;
  }
  @media (max-width: 760px) {
    .publication-summary {
      grid-template-columns: repeat(2, 1fr);
      margin-bottom: 5rem;
    }
    .publication-summary > *:nth-child(3) {
      border-left: 0;
      border-top: 1px solid hsl(var(--border));
    }
    .publication-summary > *:nth-child(4) {
      border-top: 1px solid hsl(var(--border));
    }
    .section-heading {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .selected-grid {
      grid-template-columns: 1fr;
    }
    .selected-grid article {
      min-height: 23rem;
      padding: 1.2rem 0;
      border-right: 0 !important;
    }
    .record {
      padding-top: 5rem;
    }
    .pub-year-section {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
