---
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/BaseLayout.astro'
import PageIntro from '@/components/PageIntro.astro'
import PublicationCard from '@/components/publications/PublicationCard.astro'

const entries = (await getCollection('publications')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year
  if (Boolean(b.data.featured) !== Boolean(a.data.featured)) {
    return Number(b.data.featured) - Number(a.data.featured)
  }
  return a.data.title.localeCompare(b.data.title)
})

const groupedByYear = entries.reduce<Map<number, typeof entries>>((map, entry) => {
  const group = map.get(entry.data.year) ?? []
  group.push(entry)
  map.set(entry.data.year, group)
  return map
}, new Map())

const years = [...groupedByYear.keys()].sort((a, b) => b - a)

const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint',
  thesis: 'Thesis',
  demo: 'Demo',
  other: 'Other'
}

const typesPresent = [...new Set(entries.map((entry) => entry.data.type))].sort((a, b) =>
  (typeLabels[a] ?? a).localeCompare(typeLabels[b] ?? b)
)
---

<PageLayout
  meta={{ title: 'Publications', ogImage: '/og/publications.png' }}
  highlightColor='hsl(var(--primary))'
>
  <PageIntro
    kicker='Research output'
    title='Publications'
    copy='Journal articles, conference papers, and other research output.'
  />

  {
    years.length ? (
      <div class='pub-filters' role='group' aria-label='Filter publications'>
        <label class='pub-filter'>
          <span class='pub-filter-label'>Year</span>
          <select id='pub-filter-year'>
            <option value='all'>All years</option>
            {years.map((year) => (
              <option value={year}>{year}</option>
            ))}
          </select>
        </label>
        <label class='pub-filter'>
          <span class='pub-filter-label'>Type</span>
          <select id='pub-filter-type'>
            <option value='all'>All types</option>
            {typesPresent.map((type) => (
              <option value={type}>{typeLabels[type] ?? type}</option>
            ))}
          </select>
        </label>
      </div>
    ) : null
  }

  <p id='pub-result-count' role='status'>{entries.length} publications</p>
  <p id='pub-empty' hidden>No publications match these filters. Try another year or type.</p>
  {
    years.map((year) => (
      <section class='pub-year-section' data-year-section={year}>
        <h2 class='pub-year-heading'>{year}</h2>
        <div class='pub-stack'>
          {groupedByYear.get(year)!.map((entry) => (
            <PublicationCard entry={entry} />
          ))}
        </div>
      </section>
    ))
  }
</PageLayout>

<script>
  // Under Astro's ClientRouter, this module only executes once per browser
  // session — navigating back to /publications after visiting another page
  // does NOT re-run it. So initialization is wrapped in a function and run
  // both on first load and on every `astro:page-load` (fired after every
  // client-side navigation, including the very first page load).
  function initPublicationFilters() {
    const yearSelect = document.getElementById('pub-filter-year') as HTMLSelectElement | null
    const typeSelect = document.getElementById('pub-filter-type') as HTMLSelectElement | null

    // Guard against double-binding if this ever runs twice for the same DOM.
    if (yearSelect?.dataset.filtersBound === 'true') return
    if (yearSelect) yearSelect.dataset.filtersBound = 'true'

    function applyFilters() {
      const year = yearSelect?.value ?? 'all'
      const type = typeSelect?.value ?? 'all'

      let total = 0
      document.querySelectorAll<HTMLElement>('[data-year-section]').forEach((section) => {
        let visibleCount = 0

        section.querySelectorAll<HTMLElement>('.pub-card-wrapper').forEach((card) => {
          const matchesYear = year === 'all' || card.dataset.year === year
          const matchesType = type === 'all' || card.dataset.type === type
          const visible = matchesYear && matchesType
          card.hidden = !visible
          if (visible) visibleCount += 1
        })

        section.hidden = visibleCount === 0
        total += visibleCount
      })
      const count = document.getElementById('pub-result-count')
      const empty = document.getElementById('pub-empty')
      if (count) count.textContent = `${total} publication${total === 1 ? '' : 's'}`
      if (empty) empty.hidden = total !== 0
    }

    yearSelect?.addEventListener('change', applyFilters)
    typeSelect?.addEventListener('change', applyFilters)
    applyFilters()
  }

  initPublicationFilters()
  document.addEventListener('astro:page-load', initPublicationFilters)
</script>

<style>
  #pub-result-count {
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
    margin: 1rem 0;
  }
  #pub-empty {
    padding: 2rem 0;
  }
  .pub-year-section {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 0.25rem;
  }

  .pub-year-section:first-of-type {
    margin-top: 0.5rem;
  }

  .pub-year-heading {
    margin: 0;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--primary) / 1);
  }

  .pub-stack {
    display: grid;
    gap: 1.1rem;
  }

  .pub-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid hsl(var(--border) / 1);
    background: hsl(var(--card) / 0.7);
  }

  .pub-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground) / 1);
  }

  .pub-filter-label {
    font-weight: 600;
  }

  .pub-filter select {
    border: 1px solid hsl(var(--border) / 1);
    border-radius: 0.35rem;
    background: hsl(var(--card) / 1);
    color: hsl(var(--foreground) / 1);
    padding: 0.3rem 0.55rem;
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .pub-year-section {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 2.25rem;
    }
  }
</style>
