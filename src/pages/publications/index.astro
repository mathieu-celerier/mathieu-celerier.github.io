---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/BaseLayout.astro'
import PageIntro from '@/components/PageIntro.astro'
import PublicationCard from '@/components/publications/PublicationCard.astro'

const entries = (await getCollection('publications')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year
  if (Boolean(b.data.featured) !== Boolean(a.data.featured)) {
    return Number(b.data.featured) - Number(a.data.featured)
  }
  return a.data.title.localeCompare(b.data.title)
})

const groupedByYear = entries.reduce<Map<number, typeof entries>>((map, entry) => {
  const group = map.get(entry.data.year) ?? []
  group.push(entry)
  map.set(entry.data.year, group)
  return map
}, new Map())

const years = [...groupedByYear.keys()].sort((a, b) => b - a)

const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint',
  thesis: 'Thesis',
  demo: 'Demo',
  other: 'Other'
}

const typesPresent = [...new Set(entries.map((entry) => entry.data.type))].sort(
  (a, b) => (typeLabels[a] ?? a).localeCompare(typeLabels[b] ?? b)
)
---

<PageLayout meta={{ title: 'Publications', ogImage: '/og/publications.png' }} highlightColor='hsl(199 89% 55%)'>
  <PageIntro
    kicker='Research output'
    title='Publications'
    copy='Journal articles, conference papers, and other research output.'
  />

  {
    years.length ? (
      <div class='pub-filters' role='group' aria-label='Filter publications'>
        <label class='pub-filter'>
          <span class='pub-filter-label'>Year</span>
          <select id='pub-filter-year'>
            <option value='all'>All years</option>
            {years.map((year) => (
              <option value={year}>{year}</option>
            ))}
          </select>
        </label>
        <label class='pub-filter'>
          <span class='pub-filter-label'>Type</span>
          <select id='pub-filter-type'>
            <option value='all'>All types</option>
            {typesPresent.map((type) => (
              <option value={type}>{typeLabels[type] ?? type}</option>
            ))}
          </select>
        </label>
      </div>
    ) : null
  }

  {
    years.map((year) => (
      <section class='pub-year-section' data-year-section={year}>
        <h2 class='pub-year-heading'>{year}</h2>
        <div class='pub-stack'>
          {groupedByYear.get(year)!.map((entry) => (
            <PublicationCard entry={entry} />
          ))}
        </div>
      </section>
    ))
  }
</PageLayout>

<script>
  const yearSelect = document.getElementById('pub-filter-year') as HTMLSelectElement | null
  const typeSelect = document.getElementById('pub-filter-type') as HTMLSelectElement | null

  function applyFilters() {
    const year = yearSelect?.value ?? 'all'
    const type = typeSelect?.value ?? 'all'

    document.querySelectorAll<HTMLElement>('[data-year-section]').forEach((section) => {
      let visibleCount = 0

      section.querySelectorAll<HTMLElement>('.pub-card-wrapper').forEach((card) => {
        const matchesYear = year === 'all' || card.dataset.year === year
        const matchesType = type === 'all' || card.dataset.type === type
        const visible = matchesYear && matchesType
        card.hidden = !visible
        if (visible) visibleCount += 1
      })

      section.hidden = visibleCount === 0
    })
  }

  yearSelect?.addEventListener('change', applyFilters)
  typeSelect?.addEventListener('change', applyFilters)
</script>

<style>
  .pub-year-section {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .pub-year-section:first-of-type {
    margin-top: 0.5rem;
  }

  .pub-year-heading {
    margin: 0;
    font-size: 1.5rem;
    color: hsl(var(--primary) / 1);
  }

  .pub-stack {
    display: grid;
    gap: 1.1rem;
  }

  .pub-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .pub-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground) / 1);
  }

  .pub-filter-label {
    font-weight: 600;
  }

  .pub-filter select {
    border: 1px solid hsl(var(--border) / 1);
    border-radius: 0.5rem;
    background: hsl(var(--background) / 1);
    color: hsl(var(--foreground) / 1);
    padding: 0.3rem 0.55rem;
    font-size: 0.85rem;
  }
</style>
