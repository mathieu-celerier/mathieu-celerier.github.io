---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { Button } from 'astro-pure/user'

import PageLayout from '@/layouts/BaseLayout.astro'
import NewsList from '@/components/NewsList.astro'
import PublicationCard from '@/components/publications/PublicationCard.astro'
import config from '@/site-config'
import { loadCV } from '../lib/cv-data-loader.ts'
import projectsData from '@/data/projects.generated.json'

interface Project {
  name: string
  description: string
  url: string
  homepage: string | null
  stars: number | null
  language: string | null
  topics: string[]
  featured: boolean
  source: 'github' | 'manual'
}

const cv = loadCV()

const featuredPublications = (await getCollection('publications'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 1)

const projects = (projectsData as Project[])
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 3)

const quickLinks = [
  { label: 'CV (PDF)', href: '/cv.pdf' },
  cv.basics.scholar ? { label: 'Google Scholar', href: cv.basics.scholar } : null,
  cv.basics.orcid ? { label: 'ORCID', href: cv.basics.orcid } : null,
  cv.basics.github ? { label: 'GitHub', href: `https://github.com/${cv.basics.github}` } : null,
  { label: 'Email', href: `mailto:${cv.basics.email}` }
].filter((link): link is { label: string; href: string } => link !== null)

const imagePath = config?.logo?.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
const hasLogo = typeof imagePath === 'string' && imagePath.length > 0 && !!images[imagePath]
if (imagePath && !hasLogo)
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home', ogImage: '/og/home.png' }} highlightColor='hsl(199 89% 55%)'>
  <section class='home-hero hero-grid-bg'>
    {
      hasLogo && (
        <Image
          src={images[imagePath]()}
          alt={config?.logo?.alt || 'Profile'}
          class='home-avatar'
          loading='eager'
          fetchpriority='high'
        />
      )
    }

    <p class='home-kicker'>{cv.basics.position}</p>
    <h1 class='home-title'>{config.author}</h1>
    <p class='home-role'>
      <a class='styled-link' href='https://jrl.cnrs.fr' target='_blank' rel='noreferrer'
        >CNRS-AIST Joint Robotics Laboratory (JRL)</a
      >, IRL 3218, <a
        class='styled-link'
        href='https://www.aist.go.jp/'
        target='_blank'
        rel='noreferrer'>National Institute of Advanced Industrial Science and Technology (AIST)</a
      >
    </p>

    <div class='home-actions'>
      <Button href='/cv' variant='ahead' title='CV' />
      <Button href='/publications' variant='ahead' title='Publications' />
      <Button href='/projects' variant='ahead' title='Projects' />
      <Button href={`mailto:${cv.basics.email}`} variant='ahead' title='Email' />
    </div>
  </section>

  <div id='content' class='animate home-bento'>
    <section class='bento-tile bento-tile-news' data-reveal>
      <h2 class='bento-tile-heading'>News</h2>
      <NewsList maxItems={3} compact showHeading={false} />
      <a class='styled-link bento-tile-more' href='/news'>All news →</a>
    </section>

    {
      featuredPublications.length > 0 && (
        <section class='bento-tile bento-tile-pub' data-reveal>
          <h2 class='bento-tile-heading'>Selected Publication</h2>
          <div class='bento-pub-stack'>
            {featuredPublications.map((entry) => (
              <PublicationCard entry={entry} compact />
            ))}
          </div>
          <a class='styled-link bento-tile-more' href='/publications'>All publications →</a>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section class='bento-tile bento-tile-projects' data-reveal>
          <h2 class='bento-tile-heading'>Projects</h2>
          <ul class='bento-projects-list'>
            {projects.map((project) => (
              <li>
                <a href={project.url} target='_blank' rel='noreferrer' class='bento-project-link'>
                  <span class='bento-project-name'>{project.name}</span>
                  <span class='bento-project-desc'>{project.description}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class='styled-link bento-tile-more' href='/projects'>All projects →</a>
        </section>
      )
    }

    <section class='bento-tile bento-tile-links' data-reveal>
      <h2 class='bento-tile-heading'>Quick links</h2>
      <ul class='bento-links-list'>
        {quickLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class='bento-link'
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</PageLayout>

<style>
  .home-hero {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: 2.5rem 0 2rem;
  }

  .home-avatar {
    height: 5rem;
    width: auto;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 1);
    padding: 0.25rem;
    margin-bottom: 0.4rem;
  }

  .home-kicker {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .home-title {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  .home-role {
    margin: 0.3rem 0 0;
    max-width: 42rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground) / 1);
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .home-bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    margin-top: 1.5rem;
  }

  .bento-tile {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid hsl(var(--border) / 1);
    border-radius: calc(2 * var(--radius, 0.5rem));
    background:
      radial-gradient(circle at top right, hsl(var(--primary) / 0.1), transparent 45%),
      linear-gradient(180deg, hsl(var(--background) / 0.96), hsl(var(--muted) / 0.7));
    box-shadow: 0 18px 40px -38px rgba(15, 23, 42, 0.35);
  }

  .bento-tile-heading {
    margin: 0;
    font-size: 1.15rem;
  }

  .bento-tile-more {
    justify-self: start;
    font-size: 0.9rem;
  }

  .bento-tile-news {
    grid-column: span 2;
  }

  .bento-pub-stack {
    display: grid;
    gap: 0.6rem;
  }

  .bento-projects-list,
  .bento-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .bento-project-link {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.7rem;
    border-radius: calc(1 * var(--radius, 0.5rem));
    color: inherit;
    text-decoration: none;
    background: hsl(var(--background) / 0.55);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    border: 1px solid transparent;
  }

  .bento-project-link:hover {
    border-color: hsl(var(--border) / 1);
    background: hsl(var(--background) / 0.9);
  }

  .bento-project-name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .bento-project-desc {
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.82rem;
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .bento-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 1);
    background: hsl(var(--background) / 0.7);
    color: inherit;
    text-decoration: none;
    font-size: 0.86rem;
  }

  .bento-link:hover {
    border-color: hsl(var(--primary) / 0.5);
    color: hsl(var(--primary) / 1);
  }

  @media (max-width: 767px) {
    .home-bento {
      grid-template-columns: 1fr;
    }

    .bento-tile-news {
      grid-column: span 1;
    }
  }
</style>
