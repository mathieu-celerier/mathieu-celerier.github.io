---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/BaseLayout.astro'
import NewsList from '@/components/NewsList.astro'
import config from '@/site-config'

const imagePath = config?.logo?.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
const hasLogo = typeof imagePath === 'string' && imagePath.length > 0 && !!images[imagePath]
if (imagePath && !hasLogo)
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#8A8A8A'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      {
        hasLogo && (
          <Image
            src={images[imagePath]()}
            alt={config?.logo?.alt || 'Profile'}
            class='h-28 w-auto rounded-full border p-1'
            loading='eager'
            fetchpriority='high'
          />
        )
      }

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='font-satoshi font-bold home-title'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-2 gap-y-3'>
          <p class='text-xl'>
            Postdoctoral researcher at <a class='styled-link' rel='stylesheet' href='https://jrl.cnrs.fr'
              >CNRS-AIST Joint Robotics Laboratory (JRL)</a
            >, IRL 3218, <a class='styled-link' rel='stylesheet' href='https://www.aist.go.jp/'
              >National Institute of Advanced Industrial Science and Technology (AIST)</a
            >
          </p>
        </div>
      </div>
    </section>
  </main>

  <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
    <h2 id='news-list'>News</h2>
    <NewsList maxItems={5} compact showHeading={false} />
  </div>
</PageLayout>
