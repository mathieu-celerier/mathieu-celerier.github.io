---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { Button } from 'astro-pure/user'

import PageLayout from '@/layouts/BaseLayout.astro'
import NewsList from '@/components/NewsList.astro'
import config from '@/site-config'
import { loadCV } from '../lib/cv-data-loader.ts'
import projectsData from '@/data/projects.generated.json'

interface Project {
  name: string
  description: string
  url: string
  homepage: string | null
  stars: number | null
  language: string | null
  topics: string[]
  featured: boolean
  source: 'github' | 'manual'
}

const cv = loadCV()

const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint',
  thesis: 'Thesis',
  demo: 'Demo',
  other: 'Other'
}

const allPublications = await getCollection('publications')
const featuredPublication = allPublications
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .at(0)

const allProjects = projectsData as Project[]
const projects = [...allProjects]
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 3)

const identityLinks = [
  cv.basics.scholar ? { label: 'Google Scholar', href: cv.basics.scholar } : null,
  cv.basics.orcid ? { label: 'ORCID', href: cv.basics.orcid } : null,
  cv.basics.github ? { label: 'GitHub', href: `https://github.com/${cv.basics.github}` } : null,
  cv.basics.linkedin
    ? { label: 'LinkedIn', href: `https://www.linkedin.com/in/${cv.basics.linkedin}` }
    : null,
  { label: 'Email', href: `mailto:${cv.basics.email}` }
].filter((link): link is { label: string; href: string } => link !== null)

const imagePath = config?.logo?.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
const hasLogo = typeof imagePath === 'string' && imagePath.length > 0 && !!images[imagePath]
if (imagePath && !hasLogo)
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home', ogImage: '/og/home.png' }} highlightColor='hsl(199 89% 55%)'>
  <section class='home-hero hero-grid-bg'>
    {
      hasLogo && (
        <Image
          src={images[imagePath]()}
          alt={config?.logo?.alt || 'Profile'}
          class='home-avatar'
          loading='eager'
          fetchpriority='high'
        />
      )
    }

    <p class='home-kicker'>
      <span class='home-status-dot' aria-hidden='true'></span>
      {cv.basics.position}
    </p>
    <h1 class='home-title'>{config.author}</h1>
    <p class='home-role'>
      <a class='styled-link' href='https://jrl.cnrs.fr' target='_blank' rel='noreferrer'
        >CNRS-AIST Joint Robotics Laboratory (JRL)</a
      >, IRL 3218, <a
        class='styled-link'
        href='https://www.aist.go.jp/'
        target='_blank'
        rel='noreferrer'>National Institute of Advanced Industrial Science and Technology (AIST)</a
      >
    </p>

    <div class='home-actions'>
      <Button href='/cv' variant='ahead' class='home-cta' title='View CV' />
      <Button href='/publications' variant='ahead' title='Publications' />
      <Button href='/projects' variant='ahead' title='Projects' />
    </div>

    <div class='home-identity-links'>
      {
        identityLinks.map((link) => (
          <a
            href={link.href}
            class='home-identity-pill'
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </section>

  <div id='content' class='animate home-bento'>
    <section class='bento-tile bento-tile-news' data-reveal>
      <div class='bento-tile-top'>
        <h2 class='bento-tile-heading'>News</h2>
        <a class='styled-link bento-tile-more' href='/news'>All news →</a>
      </div>
      <NewsList maxItems={3} compact flat showHeading={false} />
    </section>

    {
      featuredPublication && (
        <section class='bento-tile bento-tile-pub' data-reveal>
          <div class='bento-tile-top'>
            <h2 class='bento-tile-heading'>Featured Publication</h2>
          </div>
          <article class='bento-pub'>
            <div class='bento-pub-badges'>
              <span class='bento-pub-badge'>
                {typeLabels[featuredPublication.data.type] ?? featuredPublication.data.type}
              </span>
              <span class='bento-pub-badge'>{featuredPublication.data.year}</span>
            </div>
            <a class='bento-pub-title' href={`/publications/${featuredPublication.data.bibkey}`}>
              {featuredPublication.data.title}
            </a>
            <p class='bento-pub-authors'>{featuredPublication.data.authors}</p>
            {
              featuredPublication.data.venue ? (
                <p class='bento-pub-venue'>{featuredPublication.data.venue}</p>
              ) : null
            }
          </article>
          <a class='styled-link bento-tile-more' href='/publications'>All publications →</a>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section class='bento-tile bento-tile-projects' data-reveal>
          <div class='bento-tile-top'>
            <h2 class='bento-tile-heading'>Projects</h2>
          </div>
          <ul class='bento-projects-list'>
            {projects.map((project) => (
              <li>
                <a href={project.url} target='_blank' rel='noreferrer' class='bento-project-link'>
                  <span class='bento-project-name'>{project.name}</span>
                  <span class='bento-project-desc'>{project.description}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class='styled-link bento-tile-more' href='/projects'>All projects →</a>
        </section>
      )
    }
  </div>
</PageLayout>

<script>
  // Mouse-following spotlight on bento tiles. Document-level delegation:
  // registers once and keeps working across view-transition navigations.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  document.addEventListener('mousemove', (event) => {
    if (reduceMotion.matches) return
    const tile = (event.target as HTMLElement | null)?.closest<HTMLElement>('.bento-tile')
    if (!tile) return
    const rect = tile.getBoundingClientRect()
    tile.style.setProperty('--mx', `${event.clientX - rect.left}px`)
    tile.style.setProperty('--my', `${event.clientY - rect.top}px`)
  })
</script>

<style>
  .home-hero {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: 2.5rem 0 2rem;
  }

  /* Soft accent glow behind the hero (the grid texture lives on
     .hero-grid-bg::before; this is its companion layer). */
  .home-hero::after {
    content: '';
    position: absolute;
    top: -8rem;
    right: -6rem;
    width: 30rem;
    height: 30rem;
    border-radius: 999px;
    background: radial-gradient(circle, hsl(var(--primary) / 0.16), transparent 62%);
    pointer-events: none;
    z-index: -1;
  }

  .home-status-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 1);
    box-shadow: 0 0 0 0 hsl(var(--primary) / 0.5);
    animation: home-pulse 2.4s ease-out infinite;
  }

  @keyframes home-pulse {
    0% {
      box-shadow: 0 0 0 0 hsl(var(--primary) / 0.45);
    }
    70% {
      box-shadow: 0 0 0 0.55rem hsl(var(--primary) / 0);
    }
    100% {
      box-shadow: 0 0 0 0 hsl(var(--primary) / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-status-dot {
      animation: none;
    }
  }

  .home-avatar {
    height: 5rem;
    width: auto;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 1);
    padding: 0.25rem;
    margin-bottom: 0.4rem;
  }

  .home-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 1);
  }

  .home-title {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 0.98;
    text-wrap: balance;
    /* Subtle accent sweep on the name */
    background: linear-gradient(
      95deg,
      hsl(var(--foreground) / 1) 45%,
      hsl(var(--primary) / 0.95)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }

  .home-role {
    margin: 0.3rem 0 0;
    max-width: 42rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground) / 1);
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .home-cta {
    background: hsl(var(--foreground) / 1);
    color: hsl(var(--background) / 1);
    border-color: transparent;
  }

  .home-cta :global(svg) {
    color: hsl(var(--background) / 1);
  }

  .home-identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .home-identity-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 1);
    background: hsl(var(--background) / 0.85);
    color: hsl(var(--muted-foreground) / 1);
    text-decoration: none;
    font-size: 0.82rem;
  }

  .home-identity-pill:hover {
    color: hsl(var(--primary) / 1);
    border-color: hsl(var(--primary) / 0.4);
  }

  .home-bento {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-areas:
      'news pub'
      'news projects';
    /* Each tile sizes to its own content — forcing the news tile to
       stretch to match the pub+projects column's combined height left
       a large empty gap stretched between its (few) entries. */
    align-items: start;
    gap: 1.1rem;
    margin-top: 1.25rem;
  }

  .bento-tile {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    gap: 0.6rem;
    padding: 1.2rem 1.35rem;
    border: 1px solid hsl(var(--border) / 1);
    border-radius: calc(2 * var(--radius, 0.5rem));
    background:
      radial-gradient(circle at top right, hsl(var(--primary) / 0.09), transparent 42%),
      linear-gradient(180deg, hsl(var(--background) / 0.96), hsl(var(--muted) / 0.7));
    box-shadow: 0 18px 40px -38px rgba(15, 23, 42, 0.35);
    overflow: hidden;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* Mouse-following spotlight, driven by --mx/--my set from the script
     below. Sits under the content, above the tile background. */
  .bento-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      18rem circle at var(--mx, 50%) var(--my, 50%),
      hsl(var(--primary) / 0.08),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bento-tile:hover::after {
    opacity: 1;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bento-tile:hover {
      transform: translateY(-3px);
      border-color: hsl(var(--primary) / 0.4);
      box-shadow: 0 24px 48px -36px rgba(15, 23, 42, 0.5);
    }
  }

  .bento-tile-pub {
    border-color: hsl(var(--primary) / 0.3);
  }

  .bento-tile-news {
    grid-area: news;
  }

  .bento-tile-pub {
    grid-area: pub;
  }

  .bento-tile-projects {
    grid-area: projects;
  }

  .bento-tile-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .bento-tile-heading {
    margin: 0;
    font-size: 1.1rem;
  }

  .bento-tile-more {
    justify-self: start;
    align-self: end;
    font-size: 0.86rem;
  }

  .bento-pub {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .bento-pub-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .bento-pub-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 0.1);
    color: hsl(var(--primary) / 1);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .bento-pub-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    color: inherit;
    text-decoration: none;
  }

  .bento-pub-title:hover {
    color: hsl(var(--primary) / 1);
  }

  .bento-pub-authors {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
    color: hsl(var(--muted-foreground) / 1);
  }

  .bento-pub-venue {
    margin: 0;
    font-size: 0.82rem;
    font-style: italic;
    color: hsl(var(--muted-foreground) / 0.85);
  }

  .bento-projects-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .bento-project-link {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.65rem;
    border-radius: var(--radius, 0.5rem);
    color: inherit;
    text-decoration: none;
    background: hsl(var(--background) / 0.55);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
    border: 1px solid transparent;
  }

  .bento-project-link:hover {
    border-color: hsl(var(--border) / 1);
    background: hsl(var(--background) / 0.9);
  }

  .bento-project-name {
    font-weight: 600;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .bento-project-desc {
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.8rem;
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 860px) {
    .home-bento {
      grid-template-columns: 1fr;
      grid-template-areas:
        'news'
        'pub'
        'projects';
    }
  }
</style>
