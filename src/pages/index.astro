---
import { getCollection } from 'astro:content'
import { homeSelection } from '@/lib/home-selection'

import PageLayout from '@/layouts/BaseLayout.astro'
import ResearchJourney from '@/components/ResearchJourney.astro'
import RobotLab from '@/components/RobotLab.astro'

import { loadCV } from '../lib/cv-data-loader'

const cv = loadCV()
const allPublications = await getCollection('publications')
const leadPaper = allPublications.find((entry) => entry.data.bibkey === homeSelection.lead)
const publications = homeSelection.supporting.flatMap((key) => {
  const entry = allPublications.find((item) => item.data.bibkey === key)
  return entry && entry.id !== leadPaper?.id ? [entry] : []
})
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
---

<PageLayout meta={{ title: 'Home', ogImage: '/og/home.png' }}>
  <main>
    <RobotLab />
    <div class='research-statement'>
      <p class='eyebrow'>Beyond the demonstration</p><p>
        A robot can follow a target.<br />Working with a person asks <em>more.</em>
      </p><span>
        I design control systems that let robots respond safely, predictably, and physically to
        people.
      </span>
    </div>
    <ResearchJourney />
    <section class='selected' aria-labelledby='selected-title'>
      <div class='section-heading'>
        <div>
          <p class='eyebrow'>Selected work</p><h2 id='selected-title'>Inside the research.</h2>
        </div><a class='text-action' href='/publications'>All publications ↗</a>
      </div>
      {
        leadPaper && (
          <article class='research-feature'>
            <div class='feature-label'>
              <>
                <span class='eyebrow'>Research in focus</span>
                <span class='feature-year'>{leadPaper.data.year}</span>
              </>
            </div>
            <div class='feature-content'>
              <>
                <p class='eyebrow'>Physical human–robot interaction</p>
                <h3>
                  <a href={'/publications/' + leadPaper.data.bibkey}>{leadPaper.data.title}</a>
                </h3>
                <p class='authors'>{leadPaper.data.authors}</p>
                <a class='text-action' href={'/publications/' + leadPaper.data.bibkey}>
                  Read the research <span aria-hidden='true'>↗</span>
                </a>
              </>
            </div>
            <div class='feature-visual' aria-hidden='true'>
              <span>EXPLICIT COMPLIANCE</span>
              <svg viewBox='0 0 220 160'>
                <path class='feature-axis' d='M22 132H199M22 132V24' />
                <path class='feature-safe' d='M31 116C69 116 87 101 111 79S160 39 192 35' />
                <path class='feature-response' d='M31 122C72 121 91 108 116 82S164 45 192 39' />
                <circle cx='116' cy='82' r='7' />
                <>
                  <text x='26' y='151'>
                    γ=0
                  </text>
                  <text x='171' y='151'>
                    γ=1
                  </text>
                </>
              </svg>
              <small>STIFF ← TASK RESPONSE → COMPLIANT</small>
            </div>
          </article>
        )
      }
      <div class='paper-list'>
        {
          publications
            .filter((entry) => entry.id !== leadPaper?.id)
            .map((entry, i) => (
              <article class='paper'>
                <>
                  <span class='paper-index'>0{i + 1}</span>
                  <div>
                    <>
                      <p class='paper-meta'>
                        {entry.data.venue || entry.data.type} <span> / {entry.data.year}</span>
                      </p>
                      <h3>
                        <a href={'/publications/' + entry.data.bibkey}>{entry.data.title}</a>
                      </h3>
                      <p class='authors'>{entry.data.authors}</p>
                    </>
                  </div>
                  <a
                    class='paper-arrow'
                    href={'/publications/' + entry.data.bibkey}
                    aria-label={'Read ' + entry.data.title}
                  >
                    ↗
                  </a>
                </>
              </article>
            ))
        }
      </div>
    </section>
    <section class='updates' aria-labelledby='updates-title'>
      <div>
        <p class='eyebrow'>Along the way</p><h2 id='updates-title'>Recent news.</h2><a
          class='text-action'
          href='/news'>All updates ↗</a
        >
      </div><ol>
        {
          news.map((entry) => (
            <li>
              <>
                <time datetime={entry.data.date.toISOString()}>
                  {entry.data.date.toLocaleDateString('en-GB', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  })}
                </time>
                <a
                  href={
                    entry.data.externalUrl ||
                    (entry.data.hasPage || entry.body?.includes('{/* more */}')
                      ? '/news/' + entry.id
                      : '/news')
                  }
                >
                  {entry.data.title} ↗
                </a>
              </>
            </li>
          ))
        }
      </ol>
    </section>
    <section class='contact'>
      <div>
        <p class='eyebrow'>An open conversation</p><p>
          Interested in physical human–robot interaction?
        </p>
      </div><a href={'mailto:' + cv.basics.email}>Let’s <em>talk.</em> ↗</a>
    </section>
  </main>
</PageLayout>

<style>
  .research-statement {
    position: relative;
    padding: 5rem 0;
    max-width: 55rem;
    padding-left: 4rem;
    box-sizing: border-box;
  }
  .research-statement::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(hsl(var(--primary) / 0.08), hsl(var(--primary) / 0.42));
  }
  .research-statement > p:nth-child(2) {
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    line-height: 1.18;
    letter-spacing: -0.04em;
    margin: 1.25rem 0;
  }
  .research-statement em {
    font-family: Georgia, serif;
    color: hsl(var(--primary));
  }
  .research-statement > span {
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
  }

  .research-feature {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 13rem;
    gap: 2rem;
    padding: 3rem;
    margin-bottom: 1.5rem;
    background: #173e89;
    color: #f0f5ff;
    border-radius: 12px;
  }
  .research-feature::before {
    content: '';
    position: absolute;
    width: 35rem;
    height: 35rem;
    right: -18rem;
    top: -14rem;
    border: 1px solid #ffffff22;
    border-radius: 50%;
    box-shadow:
      0 0 0 50px #ffffff05,
      0 0 0 100px #ffffff04;
    z-index: -1;
  }
  .research-feature .eyebrow,
  .research-feature .authors {
    color: #c5d8fa;
  }
  .research-feature .feature-year {
    color: #aecfff;
  }
  .research-feature a:hover {
    color: white;
    text-decoration: underline;
  }
  .feature-visual {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-left: 1.5rem;
    border-left: 1px solid #ffffff36;
    font: 0.65rem/1.4 monospace;
    letter-spacing: 0.08em;
    color: #c5d8fa;
  }
  .feature-visual svg {
    display: block;
    width: 100%;
  }
  .feature-visual text {
    fill: #c5d8fa;
    font: 9px monospace;
  }
  .feature-axis {
    fill: none;
    stroke: #ffffff4d;
  }
  .feature-safe {
    fill: none;
    stroke: #ffffff42;
    stroke-dasharray: 4 5;
  }
  .feature-response {
    fill: none;
    stroke: #b7d6ff;
    stroke-width: 3;
  }
  .feature-visual circle {
    fill: #f06b4d;
  }
  .feature-visual small {
    font-size: 0.55rem;
  }
  .paper-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .paper-list .paper {
    grid-template-columns: 1fr 2rem;
    padding: 1.75rem;
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
    background: hsl(var(--muted) / 0.35);
  }
  .paper-index {
    grid-column: 1/-1;
    font:
      italic 2rem Georgia,
      serif !important;
  }
  .paper-list .paper h3 {
    font-size: 1.35rem;
  }
  @media (max-width: 700px) {
    .paper-list {
      grid-template-columns: 1fr;
    }
    .research-feature {
      padding: 1.5rem;
      grid-template-columns: 1fr;
    }
    .feature-visual {
      grid-column: 1;
      padding: 1rem 0 0;
      border-left: 0;
      border-top: 1px solid #ffffff36;
    }
  }
  @media (min-width: 701px) and (max-width: 900px) {
    .research-feature {
      grid-template-columns: 8rem 1fr;
    }
    .feature-visual {
      grid-column: 2;
      min-height: 11rem;
    }
  }

  .feature-label {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    border-right: 1px solid hsl(var(--border));
  }
  .feature-year {
    font:
      italic 2.6rem Georgia,
      serif;
    color: hsl(var(--primary));
  }
  .feature-content h3 {
    font-size: clamp(1.4rem, 2.7vw, 1.85rem);
    line-height: 1.25;
    margin: 0.8rem 0;
    letter-spacing: -0.025em;
  }
  .feature-content .text-action {
    margin-top: 1rem;
  }
  .paper {
    transition: background 0.2s;
  }
  .paper:hover,
  .paper:focus-within {
    background: hsl(var(--muted) / 0.5);
  }
  .paper-arrow {
    transition: transform 0.2s;
  }
  .paper:hover .paper-arrow {
    transform: translate(2px, -2px);
  }
  .contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .contact em {
    font-family: Georgia, serif;
    color: hsl(var(--primary));
  }
  @media (max-width: 600px) {
    .research-feature {
      grid-template-columns: 1fr;
      padding: 1.3rem;
      gap: 1.2rem;
    }
    .feature-label {
      flex-direction: row;
      align-items: center;
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border));
      padding-bottom: 1rem;
    }
    .feature-year {
      font-size: 1.7rem;
    }
    .contact {
      flex-direction: column;
      align-items: start;
      gap: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .paper,
    .paper-arrow {
      transition: none;
    }
    .paper:hover .paper-arrow {
      transform: none;
    }
  }
  .eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    color: hsl(var(--muted-foreground));
  }

  .text-action {
    font-size: 0.8125rem;
    display: inline-block;
    padding: 0.5rem 0;
  }

  .selected {
    padding: 0 0 4.5rem;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin: 0.7rem 0 0;
  }
  .paper {
    display: grid;
    grid-template-columns: 2rem 1fr 2rem;
    gap: 1rem;
    border-top: 1px solid hsl(var(--border));
    padding: 1.5rem 0;
  }
  .paper-index {
    font-family: monospace;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
    padding-top: 0.1rem;
  }
  .paper-meta {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: hsl(var(--primary));
    margin: 0 0 0.6rem;
  }
  .paper-meta span {
    color: hsl(var(--muted-foreground));
  }
  h3 {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.4;
    max-width: 46rem;
    margin: 0;
  }
  .authors {
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
    margin: 0.5rem 0 0;
  }
  .paper-arrow {
    align-self: center;
    font-size: 1.4rem;
    text-align: right;
  }
  .updates {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding: 2.5rem 0 4rem;
    border-top: 1px solid hsl(var(--border));
  }
  .updates .text-action {
    margin-top: 1rem;
  }
  .updates ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .updates li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .updates li:first-child {
    padding-top: 0;
  }
  time {
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
    padding-top: 0.2rem;
  }
  .updates li a {
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .contact {
    border-top: 1px solid hsl(var(--border));
    padding: 2.5rem 0 0.5rem;
  }
  .contact p {
    color: hsl(var(--muted-foreground));
    font-size: 0.85rem;
  }
  .contact > a {
    font-size: 2.5rem;
    letter-spacing: -0.04em;
  }
  @media (max-width: 760px) {
    .research-statement {
      padding: 3.5rem 0;
      padding-left: 1.5rem;
    }
    .research-statement::before {
      left: 0;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
    .updates {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .updates li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
