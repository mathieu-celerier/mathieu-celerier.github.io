---
import { getCollection } from 'astro:content'
import { labSnapshot, openQuestions, researchTracks } from '@/data/lab-home'
import { loadCV } from '@/lib/cv-data-loader'
import { homeSelection } from '@/lib/home-selection'

import PageLayout from '@/layouts/BaseLayout.astro'
import ResearchHero from '@/components/ResearchHero.astro'
import ComplianceLab from '@/components/ComplianceLab.astro'

const cv = loadCV()
const allPublications = await getCollection('publications')
const selectedKeys = [homeSelection.lead, ...homeSelection.supporting]
const publications = selectedKeys.flatMap((key) => {
  const entry = allPublications.find((item) => item.data.bibkey === key)
  return entry ? [entry] : []
})
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
---

<PageLayout meta={{ title: 'Home', ogImage: '/og/home.png' }}>
  <main>
    <ResearchHero />

    <section class='now' id='now' aria-labelledby='now-title' data-reveal>
      <div class='now-index'>
        <span class='pulse'></span><span>NOW</span><time datetime='2026-09'
          >{labSnapshot.updated}</time
        >
      </div>
      <div class='now-copy'>
        <p class='eyebrow'>Currently investigating</p>
        <h2 id='now-title'>{labSnapshot.inquiry}</h2>
      </div>
      <p class='now-note'>{labSnapshot.note}</p>
    </section>

    <section class='atlas' aria-labelledby='atlas-title'>
      <header class='atlas-header'>
        <div>
          <p class='eyebrow'>PhD work and current project</p>
          <h2 id='atlas-title'>Motion generation,<br /><em>control, prediction.</em></h2>
        </div>
        <p>
          My PhD addressed online motion generation and safe, adaptable torque control for sustained
          physical interaction. My postdoctoral project asks how a learned policy can take over one
          partner’s role in a collaborative manipulation task.
        </p>
      </header>
      <div class='track-list'>
        {
          researchTracks.map((track) => (
            <article id={`research-${track.id}`} class={`track track-${track.id}`} data-reveal>
              <div class='track-topline'>
                <span>
                  {track.index} / {track.title}
                </span>
                <span class={`status status-${track.tone}`}>{track.status}</span>
              </div>
              <div class='track-copy'>
                <h3>{track.question}</h3>
                <p>{track.detail}</p>
              </div>
              <div class='track-visual' aria-hidden='true'>
                {track.id === 'trajectory' && (
                  <svg viewBox='0 0 440 210'>
                    <path class='ghost' d='M28 170C145 170 295 40 412 40' />
                    <path class='primary-path' d='M28 170C145 170 295 40 412 40' />
                    <circle class='marker' cx='220' cy='105' r='11' />
                    <path
                      class='ticks'
                      d='M28 178V187M92 178V187M156 178V187M220 178V187M284 178V187M348 178V187M412 178V187'
                    />
                    <text x='28' y='205'>
                      t₀
                    </text>
                    <text x='398' y='205'>
                      tₙ
                    </text>
                    <text x='273' y='175'>
                      x(t) · MINIMUM JERK
                    </text>
                  </svg>
                )}
                {track.id === 'control' && (
                  <svg viewBox='0 0 440 210'>
                    <path
                      class='safe-zone'
                      d='M50 161L87 48L221 25L383 71L406 161L294 190L137 187Z'
                    />
                    <path class='primary-path' d='M59 147C124 126 155 162 221 111S315 57 379 82' />
                    <path class='danger' d='M87 48L50 161M383 71L406 161' />
                    <circle class='marker' cx='221' cy='111' r='11' />
                    <text x='177' y='103'>
                      FEASIBLE
                    </text>
                  </svg>
                )}
                {track.id === 'prediction' && (
                  <svg viewBox='0 0 440 210'>
                    <circle class='agent human' cx='96' cy='104' r='34' />
                    <circle class='agent robot' cx='344' cy='104' r='34' />
                    <path
                      class='signal signal-a'
                      d='M133 91C176 34 206 166 246 91S291 144 307 104'
                    />
                    <path
                      class='signal signal-b'
                      d='M133 116C176 59 206 191 246 116S291 169 307 129'
                    />
                    <text x='73' y='164'>
                      HUMAN
                    </text>
                    <text x='323' y='164'>
                      ROBOT
                    </text>
                    <text x='184' y='28'>
                      SHORT-HORIZON MODEL
                    </text>
                  </svg>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class='experiment' aria-labelledby='experiment-title'>
      <header class='experiment-header'>
        <div>
          <p class='eyebrow'>Interactive research model</p>
          <h2 id='experiment-title'>From compliance to virtual dynamics.</h2>
        </div>
        <p>
          In my compliance framework Γₖ is not a stiffness knob: it sets the inertia a task shows to a
          push. Generalised, the same mechanism lets the arm render an object that is not there.
        </p>
      </header>
      <ComplianceLab modes={['door']} compact />
    </section>

    <section class='evidence' aria-labelledby='evidence-title'>
      <header class='section-heading'>
        <div>
          <p class='eyebrow'>Selected publications</p>
          <h2 id='evidence-title'>Research in detail.</h2>
        </div>
        <a class='text-action' href='/publications'>Complete publication record ↗</a>
      </header>
      <div class='publication-stack'>
        {
          publications.map((entry, index) => (
            <article class='publication' data-reveal>
              <span class='publication-index'>0{index + 1}</span>
              <div class='publication-body'>
                <p class='publication-meta'>
                  {entry.data.venue || entry.data.type} / {entry.data.year}
                </p>
                <h3>
                  <a href={`/publications/${entry.data.bibkey}`}>{entry.data.title}</a>
                </h3>
                <p class='authors'>{entry.data.authors}</p>
              </div>
              <a
                class='publication-link'
                href={`/publications/${entry.data.bibkey}`}
                aria-label={`Read ${entry.data.title}`}
              >
                ↗
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class='questions' aria-labelledby='questions-title'>
      <div class='questions-intro'>
        <p class='eyebrow'>Current postdoctoral questions</p>
        <h2 id='questions-title'>Prediction in<br /><em>physical collaboration.</em></h2>
        <p>Working hypotheses for the benchmark and predictive models now under development.</p>
      </div>
      <ol>
        {
          openQuestions.map((question, index) => (
            <li data-reveal>
              <>
                <span>Q{index + 1}</span>
                <p>{question}</p>
                <i aria-hidden='true'>→</i>
              </>
            </li>
          ))
        }
      </ol>
    </section>

    <section class='log' aria-labelledby='log-title'>
      <div class='log-heading'>
        <p class='eyebrow'>Recent activity</p>
        <h2 id='log-title'>Updates.</h2>
        <a class='text-action' href='/activity#updates'>All activity ↗</a>
      </div>
      <ol>
        {
          news.map((entry) => (
            <li>
              <time datetime={entry.data.date.toISOString()}>
                {entry.data.date.toLocaleDateString('en-GB', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric'
                })}
              </time>
              <a
                href={
                  entry.data.externalUrl ||
                  (entry.data.hasPage || entry.body?.includes('{/* more */}')
                    ? `/news/${entry.id}`
                    : '/news')
                }
              >
                {entry.data.title} ↗
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class='contact'>
      <p><span class='pulse'></span> OPEN TO EXCHANGE</p>
      <a href={`mailto:${cv.basics.email}`}>Bring a question.<br /><em>Let’s explore it.</em> ↗</a>
      <div class='contact-detail'>
        <p class='contact-availability'>Worth an email:</p>
        <ul>
          <li>
            Predictive and world models for collaboration, where the environment is another
            adaptive agent rather than a passive scene.
          </li>
          <li>
            Compliant, safety-constrained torque control — particularly on platforms other than the
            ones I have already broken.
          </li>
          <li>
            Human motor-control models used as controllers rather than as descriptions, and whether
            that substitution holds.
          </li>
        </ul>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .eyebrow,
  .track-topline,
  .publication-index,
  .publication-meta {
    margin: 0;
    font: 0.7rem/1.5 monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .eyebrow {
    color: hsl(var(--primary));
  }
  h2 {
    margin: 0.65rem 0 0;
    font-size: clamp(2.4rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  h2 em {
    color: hsl(var(--primary));
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .text-action {
    font-size: 0.78rem;
  }
  .pulse {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: hsl(var(--signal));
    box-shadow: 0 0 10px hsl(var(--signal));
  }

  .now {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1.5fr) minmax(15rem, 0.7fr);
    gap: 2rem;
    align-items: start;
    padding: 8rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .now-index {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 0.6rem;
    align-items: center;
    font: 0.66rem/1.4 monospace;
    letter-spacing: 0.08em;
  }
  .now-index time {
    grid-column: 2;
    color: hsl(var(--muted-foreground));
  }
  .now-copy h2 {
    max-width: 43rem;
    font-size: clamp(2.1rem, 4.6vw, 4.5rem);
  }
  .now-note {
    margin: 2rem 0 0;
    padding-left: 1.25rem;
    border-left: 1px solid hsl(var(--signal));
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
  }

  .atlas {
    padding: 8rem 0;
  }
  .atlas-header,
  .experiment-header {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 4rem;
    align-items: end;
    margin-bottom: 4rem;
  }
  .atlas-header > p,
  .experiment-header > p {
    max-width: 30rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
  }
  .track-list {
    border-top: 1px solid hsl(var(--border));
  }
  .track {
    display: grid;
    grid-template-columns: 11rem minmax(0, 0.8fr) minmax(21rem, 1.2fr);
    gap: 2rem;
    min-height: 300px;
    padding: 2.5rem 0;
    border-bottom: 1px solid hsl(var(--border));
    align-items: center;
  }
  .track-topline {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: hsl(var(--muted-foreground));
  }
  .status {
    width: fit-content;
    padding: 0.25rem 0.45rem;
    border: 1px solid hsl(var(--border));
    border-radius: 20px;
  }
  .status-current {
    color: hsl(var(--signal));
    border-color: hsl(var(--signal) / 0.55);
  }
  .status-thesis {
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.55);
  }
  .track-copy h3 {
    max-width: 25rem;
    margin: 0;
    font-size: clamp(1.5rem, 2.7vw, 2.5rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.04em;
  }
  .track-copy p {
    max-width: 26rem;
    margin: 1.2rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
  }
  .track-visual {
    overflow: hidden;
    border-left: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
  }
  .track-visual svg {
    display: block;
    width: 100%;
  }
  .track-visual text {
    fill: currentColor;
    font: 9px monospace;
    letter-spacing: 0.08em;
  }
  .ghost,
  .primary-path,
  .ticks,
  .safe-zone,
  .danger,
  .agent,
  .signal {
    fill: none;
    stroke: currentColor;
  }
  .ghost {
    opacity: 0.18;
    stroke-width: 14;
  }
  .primary-path {
    stroke: hsl(var(--primary));
    stroke-width: 2.5;
  }
  .ticks {
    opacity: 0.4;
  }
  .marker {
    fill: hsl(var(--signal));
  }
  .safe-zone {
    fill: hsl(var(--primary) / 0.06);
    stroke: hsl(var(--primary));
    stroke-dasharray: 5 7;
  }
  .danger {
    stroke: hsl(var(--signal));
    stroke-width: 5;
  }
  .agent {
    stroke-width: 2;
  }
  .human {
    fill: hsl(var(--signal) / 0.1);
    stroke: hsl(var(--signal));
  }
  .robot {
    fill: hsl(var(--primary) / 0.1);
    stroke: hsl(var(--primary));
  }
  .signal {
    stroke-width: 2;
  }
  .signal-a {
    stroke: hsl(var(--primary));
  }
  .signal-b {
    stroke: hsl(var(--signal));
    opacity: 0.65;
  }
  .track:hover .primary-path {
    animation: trace 1.2s ease both;
  }
  .track:hover .signal-a {
    animation: signal-shift 1.3s ease-in-out infinite alternate;
  }
  @keyframes trace {
    from {
      stroke-dasharray: 0 700;
    }
    to {
      stroke-dasharray: 700 0;
    }
  }
  @keyframes signal-shift {
    to {
      transform: translateY(8px);
    }
  }

  .experiment {
    width: calc(100vw - 2rem);
    max-width: 1500px;
    margin-left: 50%;
    padding: 7rem max(1rem, calc((100% - 62rem) / 2));
    transform: translateX(-50%);
    box-sizing: border-box;
    background: hsl(var(--experiment-background));
    color: hsl(var(--experiment-foreground));
  }
  .experiment-header {
    max-width: 62rem;
    margin-inline: auto;
  }
  .experiment-header > p {
    color: hsl(var(--experiment-foreground) / 0.72);
  }

  .evidence {
    padding: 8rem 0;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .section-heading h2 {
    font-size: clamp(2.4rem, 4vw, 4rem);
  }
  .publication-stack {
    border-top: 1px solid hsl(var(--border));
  }
  .publication {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 3rem;
    gap: 2rem;
    padding: 2.2rem 0;
    border-bottom: 1px solid hsl(var(--border));
    transition:
      padding 220ms ease,
      background 220ms ease;
  }
  .publication:hover {
    padding-inline: 1.25rem;
    background: hsl(var(--muted) / 0.5);
  }
  .publication-index {
    color: hsl(var(--primary));
  }
  .publication-meta {
    margin-bottom: 0.55rem;
    color: hsl(var(--muted-foreground));
  }
  .publication h3 {
    max-width: 50rem;
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .authors {
    margin: 0.55rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
  }
  .publication-link {
    align-self: center;
    justify-self: end;
    font-size: 1.3rem;
  }

  .questions {
    display: grid;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    gap: 5rem;
    padding: 7rem 3rem;
    border-radius: 12px;
    background: hsl(var(--muted));
  }
  .questions-intro > p:last-child {
    max-width: 25rem;
    color: hsl(var(--muted-foreground));
  }
  .questions ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid hsl(var(--border));
  }
  .questions li {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 7rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .questions li span {
    font: 0.65rem monospace;
    color: hsl(var(--primary));
  }
  .questions li p {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.35;
  }
  .questions li i {
    color: hsl(var(--signal));
    font-style: normal;
  }

  .log {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: 4rem;
    padding: 8rem 0;
  }
  .log-heading .text-action {
    margin-top: 1rem;
  }
  .log ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid hsl(var(--border));
  }
  .log li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .log time {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
  }
  .log a {
    font-size: 0.88rem;
  }

  .contact {
    display: grid;
    grid-template-columns: 0.5fr 1.5fr;
    gap: 3rem;
    align-items: start;
    padding: 5rem 0 2rem;
    border-top: 1px solid hsl(var(--border));
  }
  .contact > p {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font: 0.66rem monospace;
    letter-spacing: 0.08em;
  }
  .contact > a {
    font-size: clamp(2.7rem, 6vw, 6rem);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }
  .contact-detail {
    grid-column: 2;
    max-width: 38rem;
    margin-top: 2.5rem;
  }
  .contact-availability {
    margin: 0 0 1.25rem;
    color: hsl(var(--foreground));
  }
  .contact-detail ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid hsl(var(--border));
  }
  .contact-detail li {
    padding: 0.85rem 0;
    border-bottom: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 0.92rem;
  }
  .contact em {
    color: hsl(var(--primary));
    font-family: Georgia, serif;
    font-weight: 400;
  }

  @media (max-width: 800px) {
    .now {
      grid-template-columns: 7rem 1fr;
      padding: 6rem 0;
    }
    .now-note {
      grid-column: 2;
    }
    .atlas-header,
    .experiment-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .track {
      grid-template-columns: 7rem 1fr;
    }
    .track-visual {
      grid-column: 2;
      border-left: 0;
    }
    .questions {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 4rem 2rem;
    }
  }
  @media (max-width: 600px) {
    .now {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .now-note {
      grid-column: 1;
      margin-top: 0;
    }
    .atlas {
      padding: 6rem 0;
    }
    .track {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .track-topline {
      flex-direction: row;
    }
    .track-visual {
      grid-column: 1;
    }
    .experiment {
      width: 100vw;
      padding: 5rem 0;
    }
    .experiment-header {
      padding-inline: 1rem;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
    .evidence {
      padding: 6rem 0;
    }
    .publication {
      grid-template-columns: 2rem 1fr 1.5rem;
      gap: 0.75rem;
    }
    .publication:hover {
      padding-inline: 0;
    }
    .questions {
      width: 100vw;
      margin-left: 50%;
      padding: 4rem 1rem;
      transform: translateX(-50%);
      box-sizing: border-box;
      border-radius: 0;
    }
    .questions li {
      grid-template-columns: 2rem 1fr auto;
    }
    .log {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 6rem 0;
    }
    .log li {
      grid-template-columns: 6rem 1fr;
    }
    .contact {
      grid-template-columns: 1fr;
    }
    .contact-detail {
      grid-column: 1;
      margin-top: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track:hover .primary-path,
    .track:hover .signal-a {
      animation: none;
    }
    .publication {
      transition: none;
    }
  }
</style>
