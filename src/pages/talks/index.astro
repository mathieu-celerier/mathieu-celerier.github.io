---
import PageLayout from '@/layouts/BaseLayout.astro'
import PageIntro from '@/components/PageIntro.astro'
import { Button } from 'astro-pure/user'
import { loadTalks } from '@/lib/talks-data-loader'

const talks = loadTalks()
  .filter((talk) => !Number.isNaN(Date.parse(talk.date)))
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))

const groupedByYear = talks.reduce<Map<number, typeof talks>>((map, talk) => {
  const year = new Date(talk.date).getFullYear()
  const group = map.get(year) ?? []
  group.push(talk)
  map.set(year, group)
  return map
}, new Map())

const years = [...groupedByYear.keys()].sort((a, b) => b - a)

function formatDate(iso: string) {
  const date = new Date(iso)
  return date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
}
---

<PageLayout meta={{ title: 'Talks', ogImage: '/og/talks.png' }} highlightColor='hsl(199 89% 55%)'>
  <PageIntro
    kicker='Speaking'
    title='Talks & Media'
    copy='Conference talks, demonstrations, and other public presentations of my research.'
  />

  {
    years.length ? (
      years.map((year) => (
        <section class='talks-year-section'>
          <h2 class='talks-year-heading'>{year}</h2>
          <div class='talks-stack'>
            {groupedByYear.get(year)!.map((talk) => (
              <article class='talk-card' data-reveal>
                <p class='talk-date'>{formatDate(talk.date)}</p>
                <h3 class='talk-title'>{talk.title}</h3>
                <p class='talk-meta'>
                  {talk.event} · {talk.location}
                </p>
                <div class='talk-links'>
                  {talk.links?.slides ? (
                    <Button href={talk.links.slides} target='_blank' variant='ahead' title='Slides' />
                  ) : null}
                  {talk.links?.video ? (
                    <Button href={talk.links.video} target='_blank' variant='ahead' title='Video' />
                  ) : null}
                  {talk.links?.poster ? (
                    <Button href={talk.links.poster} target='_blank' variant='ahead' title='Poster' />
                  ) : null}
                  {talk.links?.website ? (
                    <Button href={talk.links.website} target='_blank' variant='ahead' title='Website' />
                  ) : null}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    ) : (
      <p class='talks-empty'>Nothing listed yet.</p>
    )
  }
</PageLayout>

<style>
  .talks-year-section {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .talks-year-section:first-of-type {
    margin-top: 0.5rem;
  }

  .talks-year-heading {
    margin: 0;
    font-size: 1.5rem;
    color: hsl(var(--primary) / 1);
  }

  .talks-stack {
    display: grid;
    gap: 1.1rem;
  }

  .talk-card {
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid hsl(var(--border) / 1);
    border-radius: calc(2 * var(--radius, 0.5rem));
    background:
      linear-gradient(180deg, hsl(var(--background) / 0.96), hsl(var(--muted) / 0.7));
  }

  .talk-date {
    margin: 0;
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .talk-title {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .talk-meta {
    margin: 0;
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.92rem;
  }

  .talk-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.4rem;
  }

  .talks-empty {
    color: hsl(var(--muted-foreground) / 1);
  }
</style>
