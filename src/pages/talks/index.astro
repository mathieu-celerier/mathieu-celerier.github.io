---
import { loadTalks } from '@/lib/talks-data-loader'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import PageIntro from '@/components/PageIntro.astro'

const talks = loadTalks()
  .filter((talk) => !Number.isNaN(Date.parse(talk.date)))
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))

const groupedByYear = talks.reduce<Map<number, typeof talks>>((map, talk) => {
  const year = new Date(talk.date).getFullYear()
  const group = map.get(year) ?? []
  group.push(talk)
  map.set(year, group)
  return map
}, new Map())

const years = [...groupedByYear.keys()].sort((a, b) => b - a)

function formatDate(iso: string) {
  const date = new Date(iso)
  return date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
}
---

<PageLayout
  meta={{ title: 'Talks', ogImage: '/og/talks.png' }}
  highlightColor='hsl(var(--primary))'
>
  <PageIntro
    kicker='Speaking'
    title='Talks & Media'
    copy='Conference talks, demonstrations, and other public presentations of my research.'
  />

  {
    years.length ? (
      years.map((year) => (
        <section class='talks-year-section'>
          <h2 class='talks-year-heading'>{year}</h2>
          <div class='talks-stack'>
            {groupedByYear.get(year)!.map((talk) => (
              <article class='talk-card' data-reveal>
                <p class='talk-date'>{formatDate(talk.date)}</p>
                <h3 class='talk-title'>{talk.title}</h3>
                <p class='talk-meta'>
                  {talk.event} · {talk.location}
                </p>
                <div class='talk-links'>
                  {talk.links?.slides ? (
                    <Button
                      href={talk.links.slides}
                      target='_blank'
                      variant='ahead'
                      title='Slides'
                    />
                  ) : null}
                  {talk.links?.video ? (
                    <Button href={talk.links.video} target='_blank' variant='ahead' title='Video' />
                  ) : null}
                  {talk.links?.poster ? (
                    <Button
                      href={talk.links.poster}
                      target='_blank'
                      variant='ahead'
                      title='Poster'
                    />
                  ) : null}
                  {talk.links?.website ? (
                    <Button
                      href={talk.links.website}
                      target='_blank'
                      variant='ahead'
                      title='Website'
                    />
                  ) : null}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    ) : (
      <p class='talks-empty'>Nothing listed yet.</p>
    )
  }
</PageLayout>

<style>
  .talks-year-section {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .talks-year-section:first-of-type {
    margin-top: 0.5rem;
  }

  .talks-year-heading {
    margin: 0;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--primary) / 1);
  }

  .talks-stack {
    display: grid;
    gap: 1.1rem;
  }

  .talk-card {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    padding: 1.25rem 0;
    border: 1px solid hsl(var(--border) / 1);
    border-inline: 0;
    background: transparent;
  }

  .talk-date {
    margin: 0;
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .talk-title {
    margin: 0;
    grid-column: 2;
    grid-row: 1;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.4;
  }

  .talk-meta {
    margin: 0;
    grid-column: 2;
    color: hsl(var(--muted-foreground) / 1);
    font-size: 1rem;
  }

  .talk-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    grid-column: 2;
    margin-top: 0.4rem;
  }

  .talks-empty {
    color: hsl(var(--muted-foreground) / 1);
  }

  @media (max-width: 600px) {
    .talks-year-section {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 2.25rem;
    }
    .talk-card {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
    .talk-title,
    .talk-meta,
    .talk-links {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
