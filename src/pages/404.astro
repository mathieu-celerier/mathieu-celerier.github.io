---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Not found',
  title: '404'
}
---

<PageLayout {meta}>
  <div class='not-found'>
    <p class='not-found-kicker'>Navigation error</p>
    <h1>404</h1>
    <p class='not-found-copy'>This page is not part of the current research record.</p>
    <Button title='Back to home' href='/' variant='ahead' class='mt-5' />
  </div>
</PageLayout>

<style>
  .not-found { max-width: 45rem; padding: clamp(5rem, 16vw, 12rem) 0; border-bottom: 1px solid hsl(var(--border) / 1); }
  .not-found-kicker { margin: 0 0 0.75rem; color: hsl(var(--primary) / 1); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .not-found h1 { margin: 0; font-size: clamp(6rem, 22vw, 14rem); line-height: 0.78; letter-spacing: -0.08em; }
  .not-found-copy { max-width: 28rem; margin: 1.5rem 0 0; color: hsl(var(--muted-foreground) / 1); font-size: 1.15rem; }
</style>
